const uint32_t SAMPLE_3_LEN = 148712UL;

const int16_t* const LOOP_DATA[NUM_LOOPS] = {
  LOOP_0, LOOP_1, LOOP_2, LOOP_3, LOOP_4
};
const uint32_t LOOP_LEN[NUM_LOOPS] = {
  LOOP_0_LEN, LOOP_1_LEN, LOOP_2_LEN, LOOP_3_LEN, LOOP_4_LEN
};
const int16_t* const SAMPLE_DATA[NUM_SAMPLES] = {
  SAMPLE_0, SAMPLE_1, SAMPLE_2, SAMPLE_3
};
const uint32_t SAMPLE_LEN[NUM_SAMPLES] = {
  SAMPLE_0_LEN, SAMPLE_1_LEN, SAMPLE_2_LEN, SAMPLE_3_LEN
};

const int BTN_PINS[5]  = {44, 42, 0, 45, 47};
const int PIEZO_ADC[4] = {4, 5, 6, 7};
static bool     btnPrev[5]        = {false};
static uint32_t piezoLastTrig[4]  = {0};
static uint32_t lastAnyPiezoTrig  = 0;   // lockout cruzado anti-crosstalk

// ================================================================
// ESTADO COMPARTIDO — volatile para dual-core (Core0=audio, Core1=controls)
// activeLoop: -1 = ningún loop sonando · 0..NUM_LOOPS-1 = loop activo (mono)
// sampleVoice[v]: una voz polifónica por piezo, paralela al loop activo
// ================================================================
volatile int   activeLoop = -1;
volatile float loopPhase[NUM_LOOPS];

struct SampleVoice {
  bool  active;
  float phase;
};
volatile SampleVoice sampleVoice[NUM_SAMPLES];

volatile float pitchRatio = 1.0f;
volatile float masterVol  = 1.0f;
volatile float rawHPFnorm = 0.0f;   // 0=20Hz  1=4000Hz
volatile float rawLPFnorm = 0.5f;   // 0=200Hz 1=20kHz — seteado por IMU
volatile float rawResnorm = 0.0f;   // 0=Q0.5  1=Q6.0  — ADC 8

// ================================================================
// I2S
// ================================================================
static i2s_chan_handle_t i2s_tx;

void i2s_init() {
  i2s_chan_config_t cc = I2S_CHANNEL_DEFAULT_CONFIG(I2S_NUM_0, I2S_ROLE_MASTER);
  i2s_new_channel(&cc, &i2s_tx, NULL);
  i2s_std_config_t sc = {
    .clk_cfg  = I2S_STD_CLK_DEFAULT_CONFIG(SAMPLE_RATE),
    .slot_cfg = I2S_STD_PHILIPS_SLOT_DEFAULT_CONFIG(I2S_DATA_BIT_WIDTH_16BIT, I2S_SLOT_MODE_STEREO),
    .gpio_cfg = {
      .mclk = I2S_GPIO_UNUSED,
      .bclk = (gpio_num_t)41,
      .ws   = (gpio_num_t)39,
      .dout = (gpio_num_t)40,
      .din  = I2S_GPIO_UNUSED
    }
  };
  i2s_channel_init_std_mode(i2s_tx, &sc);
  i2s_channel_enable(i2s_tx);
}

// ================================================================
// DSP — HPF one-pole + LPF biquad (RBJ cookbook)
// HPF one-pole: y[n] = a*(y[n-1] + x[n] - x[n-1]),  a = RC/(RC+dt)
// LPF biquad: Q de ADC8 — resonancia controlable 0.5-6.0
// ================================================================
float hpf_x1=0, hpf_y1=0, hpf_a=0.99f;
float lpf_x1=0, lpf_x2=0, lpf_y1=0, lpf_y2=0;
float lpf_b0=1, lpf_b1=0, lpf_b2=0, lpf_a1=0, lpf_a2=0;

void computeHPF(float fc) {
  if (fc < 1.0f) fc = 1.0f;
  float rc = 1.0f / (2.0f * (float)M_PI * fc);
  float dt = 1.0f / (float)SAMPLE_RATE;
  hpf_a = rc / (rc + dt);
  if (hpf_a > 0.9999f) hpf_a = 0.9999f;
}

float applyHPF(float x) {
  float y = hpf_a * (hpf_y1 + x - hpf_x1);
  hpf_x1 = x; hpf_y1 = y;
  return y;
}

void computeLPF(float fc, float Q) {
  float maxFc = (float)SAMPLE_RATE * 0.45f;
  if (fc < 1.0f)   fc = 1.0f;
  if (fc > maxFc)  fc = maxFc;
  if (Q  < 0.5f)   Q  = 0.5f;
  float w = 2.0f * (float)M_PI * fc / (float)SAMPLE_RATE;
  float c = cosf(w), s = sinf(w);
  float a = s / (2.0f * Q);
  float norm = 1.0f / (1.0f + a);
  lpf_b0 = (1.0f - c) * 0.5f * norm;
  lpf_b1 = (1.0f - c) * norm;
  lpf_b2 = lpf_b0;
  lpf_a1 = -2.0f * c * norm;
  lpf_a2 = (1.0f - a) * norm;
}

float applyLPF(float x) {
  float y = lpf_b0*x + lpf_b1*lpf_x1 + lpf_b2*lpf_x2
            - lpf_a1*lpf_y1 - lpf_a2*lpf_y2;
  lpf_x2 = lpf_x1; lpf_x1 = x;
  lpf_y2 = lpf_y1; lpf_y1 = y;
  return y;
}

int readPot(int pin) {
  int s = 0;
  for (int i = 0; i < 8; i++) s += analogRead(pin);
  return s >> 3;
}

// ================================================================
// IMU — MPU6050 I2C SDA=21 SCL=38
// AccelY: horizontal=~10kHz, inclinado=-Y=200Hz, +Y=20kHz
// ================================================================
void initIMU() {
  Wire.begin(21, 38);
  Wire.beginTransmission(MPU_ADDR);
  Wire.write(0x6B);
  Wire.write(0);
  Wire.endTransmission(true);
}

bool readIMU(int16_t &ax, int16_t &ay) {
  Wire.beginTransmission(MPU_ADDR);
  Wire.write(0x3B);
  if (Wire.endTransmission(false) != 0) return false;
  Wire.requestFrom((uint8_t)MPU_ADDR, (uint8_t)4, (uint8_t)true);
  if (Wire.available() < 4) return false;
  ax = (int16_t)((Wire.read() << 8) | Wire.read());
  ay = (int16_t)((Wire.read() << 8) | Wire.read());
  return true;
}

// ================================================================
// AUDIO TASK — Core 0 — sin I2C ni ADC
// Mezcla: loop activo (looping) + voces polifónicas one-shot de piezos
// ================================================================
void audioTask(void*) {
  int16_t buf[BUF_SAMPLES * 2];
  for (;;) {
    computeHPF(20.0f * powf(200.0f, rawHPFnorm));
    float lpfQ = 0.5f + rawResnorm * 5.5f;  // 0.5 – 6.0
    computeLPF(200.0f * powf(100.0f, rawLPFnorm), lpfQ);
    for (int s = 0; s < BUF_SAMPLES; s++) {
      float mix = 0.0f;

      // Loop activo (mono switcher) — looping con interpolación lineal
      int al = activeLoop;
      if (al >= 0 && al < NUM_LOOPS && LOOP_LEN[al] > 0) {
        float phase = loopPhase[al];
        uint32_t len = LOOP_LEN[al];
        uint32_t pos = (uint32_t)phase;
        if (pos >= len) pos = 0;
        float frac = phase - (float)pos;
        uint32_t p1 = (pos + 1 < len) ? pos + 1 : 0;
        float s0 = (float)LOOP_DATA[al][pos];
        float s1 = (float)LOOP_DATA[al][p1];
        mix += s0 + frac * (s1 - s0);
        phase += pitchRatio;
        if ((uint32_t)phase >= len) phase -= (float)len;
        loopPhase[al] = phase;
      }

      // Voces polifónicas — un slot por piezo, one-shot (no loop)
      for (int v = 0; v < NUM_SAMPLES; v++) {
        if (!sampleVoice[v].active || SAMPLE_LEN[v] == 0) continue;
        float phase = sampleVoice[v].phase;
        uint32_t len = SAMPLE_LEN[v];
        uint32_t pos = (uint32_t)phase;
        if (pos + 1 >= len) {
          // Fin de muestra — desactivar voz
          sampleVoice[v].active = false;
          sampleVoice[v].phase  = 0.0f;
          continue;
        }
        float frac = phase - (float)pos;
        float s0 = (float)SAMPLE_DATA[v][pos];
        float s1 = (float)SAMPLE_DATA[v][pos + 1];
        mix += s0 + frac * (s1 - s0);
        sampleVoice[v].phase = phase + pitchRatio;
      }

      mix /= 32768.0f;
      mix  = applyHPF(mix);
      mix  = applyLPF(mix);
      mix *= masterVol;
      // Soft limiter: protege contra picos de resonancia y suma polifónica
      if      (mix >  1.0f) mix =  1.0f;
      else if (mix < -1.0f) mix = -1.0f;
      int32_t out = (int32_t)(mix * 32767.0f);
      if (out >  32767) out =  32767;
      if (out < -32768) out = -32768;
      buf[s*2]   = (int16_t)out;
      buf[s*2+1] = (int16_t)out;
    }
    size_t written;
    i2s_channel_write(i2s_tx, buf, sizeof(buf), &written, portMAX_DELAY);
  }
}

// ================================================================
// SETUP
// ================================================================
void setup() {
  // Serial deshabilitado
  analogReadResolution(12);
  for (int i = 0; i < 5; i++) pinMode(BTN_PINS[i], INPUT_PULLUP);
  memset((void*)loopPhase, 0, sizeof(loopPhase));
  for (int v = 0; v < NUM_SAMPLES; v++) {
    sampleVoice[v].active = false;
    sampleVoice[v].phase  = 0.0f;
  }
  i2s_init();
  initIMU();
  // Pre-leer pots para evitar silencio en los primeros frames
  pitchRatio = 0.5f * powf(4.0f, readPot(POT_PITCH) / 4095.0f);
  masterVol  = 0.1f + 0.9f * (readPot(POT_VOL) / 4095.0f);
  rawHPFnorm = readPot(POT_HPF) / 4095.0f;
  rawResnorm = readPot(POT_RES) / 4095.0f;
  rawLPFnorm = 0.5f;
  activeLoop = -1;   // arranca en silencio hasta que se presione un BTN
  xTaskCreatePinnedToCore(audioTask, "audio", 8192, NULL, 24, NULL, 0);
}

// ================================================================
// LOOP — Core 1 — controles cada 20 ms
// ================================================================
void loop() {
  static uint32_t lastCtrl = 0;
  uint32_t now = millis();

  if (now - lastCtrl >= 20) {
    lastCtrl = now;
    pitchRatio = 0.5f * powf(4.0f, readPot(POT_PITCH) / 4095.0f);
    masterVol  = 0.1f + 0.9f * (readPot(POT_VOL) / 4095.0f);
    rawHPFnorm = readPot(POT_HPF) / 4095.0f;
    rawResnorm = readPot(POT_RES) / 4095.0f;
    // IMU AccelX → LPF freq (plano=10kHz, inclinar→bajar o subir)
    int16_t imuX = 0, imuY = 0;
    if (readIMU(imuX, imuY)) {
      float yn = imuY / 16384.0f;
      if (yn < -1.0f) yn = -1.0f;
      if (yn >  1.0f) yn =  1.0f;
      rawLPFnorm = (yn + 1.0f) * 0.5f;
    }
  }

  // BTN: mono switcher entre loops (solo uno activo a la vez)
  for (int i = 0; i < NUM_LOOPS; i++) {
    bool cur = !digitalRead(BTN_PINS[i]);
    if (cur && !btnPrev[i] && LOOP_LEN[i] > 0) {
      loopPhase[i] = 0.0f;
      activeLoop   = i;
    }
    btnPrev[i] = cur;
  }

  // PIEZO: dispara voz polifónica one-shot · paralela al loop activo
  for (int p = 0; p < NUM_SAMPLES; p++) {
    int val = analogRead(PIEZO_ADC[p]);
    if (val > PIEZO_THRESHOLD
        && (now - piezoLastTrig[p])   > PIEZO_DEBOUNCE_MS
        && (now - lastAnyPiezoTrig)   > CROSS_DEBOUNCE_MS
        && SAMPLE_LEN[p] > 0) {
      sampleVoice[p].phase  = 0.0f;
      sampleVoice[p].active = true;
      piezoLastTrig[p]      = now;
      lastAnyPiezoTrig      = now;   // bloquea los demás piezos por CROSS_DEBOUNCE_MS
    }
  }

  delay(1);
}