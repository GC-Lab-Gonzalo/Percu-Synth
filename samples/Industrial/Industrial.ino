  // Serial deshabilitado
  analogReadResolution(12);
  for (int i = 0; i < 5; i++) pinMode(BTN_PINS[i], INPUT_PULLUP);
  memset((void*)loopPhase, 0, sizeof(loopPhase));
  for (int v = 0; v < NUM_SAMPLES; v++) {
    sampleVoice[v].active = false;
    sampleVoice[v].phase  = 0.0f;
  }
  i2s_init();
  initIMU();
  // Pre-leer pots para evitar silencio en los primeros frames
  pitchRatio = 0.5f * powf(4.0f, readPot(POT_PITCH) / 4095.0f);
  masterVol  = 0.1f + 0.9f * (readPot(POT_VOL) / 4095.0f);
  rawHPFnorm = readPot(POT_HPF) / 4095.0f;
  rawResnorm = readPot(POT_RES) / 4095.0f;
  rawLPFnorm = 0.5f;
  activeLoop = -1;   // arranca en silencio hasta que se presione un BTN
  xTaskCreatePinnedToCore(audioTask, "audio", 8192, NULL, 24, NULL, 0);
}

// ================================================================
// LOOP — Core 1 — controles cada 20 ms
// ================================================================
void loop() {
  static uint32_t lastCtrl = 0;
  uint32_t now = millis();

  if (now - lastCtrl >= 20) {
    lastCtrl = now;
    pitchRatio = 0.5f * powf(4.0f, readPot(POT_PITCH) / 4095.0f);
    masterVol  = 0.1f + 0.9f * (readPot(POT_VOL) / 4095.0f);
    rawHPFnorm = readPot(POT_HPF) / 4095.0f;
    rawResnorm = readPot(POT_RES) / 4095.0f;
    // IMU AccelX → LPF freq (plano=10kHz, inclinar→bajar o subir)
    int16_t imuX = 0, imuY = 0;
    if (readIMU(imuX, imuY)) {
      float yn = imuY / 16384.0f;
      if (yn < -1.0f) yn = -1.0f;
      if (yn >  1.0f) yn =  1.0f;
      rawLPFnorm = (yn + 1.0f) * 0.5f;
    }
  }

  // BTN: mono switcher entre loops (solo uno activo a la vez)
  for (int i = 0; i < NUM_LOOPS; i++) {
    bool cur = !digitalRead(BTN_PINS[i]);
    if (cur && !btnPrev[i] && LOOP_LEN[i] > 0) {
      loopPhase[i] = 0.0f;
      activeLoop   = i;
    }
    btnPrev[i] = cur;
  }

  // PIEZO: dispara voz polifónica one-shot · paralela al loop activo
  for (int p = 0; p < NUM_SAMPLES; p++) {
    int val = analogRead(PIEZO_ADC[p]);
    if (val > PIEZO_THRESHOLD
        && (now - piezoLastTrig[p]) > PIEZO_DEBOUNCE_MS
        && SAMPLE_LEN[p] > 0) {
      sampleVoice[p].phase  = 0.0f;
      sampleVoice[p].active = true;
      piezoLastTrig[p]      = now;
    }
  }

  delay(1);
}