// ==============================================================================================================================================
// DISPAROS
// ==============================================================================================================================================
// Campanita: parciales ARMÓNICOS largos (1, 2, 3) + un golpe inarmónico (4.2) que muere en una fracción de segundo.
// Muchas campanas inarmónicas largas a la vez se suman en un lavado disonante (lección de la_partida).
void tocarCampana(int g, float amp, float pan, float envio) {
  int idx = 0; float menor = 1e9f;
  for (int i = 0; i < NUM_CAMPANAS; i++) {
    if (!campanas[i].viva) { idx = i; menor = -1.0f; break; }
    float e = campanas[i].e[0] * campanas[i].amp;
    if (e < menor) { menor = e; idx = i; }
  }
  Campana &c = campanas[idx];
  const float R[4] = { 1.0f, 2.0f, 3.0f, 4.2f }, A[4] = { 1.0f, 0.38f, 0.14f, 0.10f }, TT[4] = { 1.0f, 0.5f, 0.28f, 0.06f };
  float f = hzGrado(g) * (1.0f + (frnd() - 0.5f) * 0.0035f);
  float tau = (0.55f + 0.5f * frnd()) * (g > 22 ? 0.75f : 1.0f);     // la fundamental suena ~3·tau
  for (int k = 0; k < 4; k++) {
    c.ph[k] = 0.0f; c.inc[k] = f * R[k] * INV_SR; if (c.inc[k] > 0.4f) c.inc[k] = 0.0f;
    c.e[k] = A[k]; c.d[k] = decaimiento(tau * TT[k]);
  }
  c.amp = amp; c.envio = envio; panear(pan, c.gL, c.gR); c.viva = true;
}

// Arpa: Karplus-Strong afinado con un pasa-todos fraccional (una cuerda pulsada de verdad, barata)
void tocarArpa(int g, float vel, float amp, float pan) {
  int idx = 0; float menor = 1e9f;
  for (int i = 0; i < NUM_ARPAS; i++) {
    if (!arpas[i].viva) { idx = i; break; }
    float e = arpas[i].nivel * arpas[i].amp;
    if (e < menor) { menor = e; idx = i; }
  }
  Arpa &a = arpas[idx];
  float f = hzGrado(g), total = SR / f;
  int L = (int)(total - 0.6f); if (L > KS_MAX) L = KS_MAX; if (L < 4) L = 4;
  float d = total - 0.5f - L;                     // retardo total = L + 0.5 (promedio) + d (pasa-todos)
  a.c = (1.0f - d) / (1.0f + d);
  a.largo = L; a.pos = 0; a.apX = a.apY = 0.0f; a.prev = 0.0f;
  float t60 = 2.0f + 1.4f * frnd();
  a.perdida = expf(-6.91f / (t60 * f));
  // excitación: ruido suavizado (más suave = más arpa, menos clavecín), sin continua
  float lp = 0.0f, k = 0.18f + 0.25f * vel, media = 0.0f, pico = 1e-6f;
  for (int j = 0; j < L; j++) { lp += k * (ruido(semExc) - lp); a.buf[j] = lp; media += lp; }
  media /= L;
  for (int j = 0; j < L; j++) { a.buf[j] -= media; float m = fabsf(a.buf[j]); if (m > pico) pico = m; }
  float esc = vel / pico;
  for (int j = 0; j < L; j++) a.buf[j] *= esc;
  a.amp = amp; a.nivel = 1.0f; panear(pan, a.gL, a.gR); a.viva = true;
}

// Percusión afinada de la paleta (kalimba, marimba, caja de música, vibráfono, vidrio). conOctava = false en la capa
// de kalimba, que ya vive arriba: subirla otra octava la volvía chillona.
void tocarPerc(int timbre, int g, float amp, float pan, bool conOctava) {
  int idx = 0; float menor = 1e9f;
  for (int i = 0; i < NUM_PERCS; i++) {
    if (!percs[i].viva) { idx = i; break; }
    float e = percs[i].e[0] * percs[i].amp;
    if (e < menor) { menor = e; idx = i; }
  }
  const TimbrePerc &T = TIMBRES[timbre];
  Perc &p = percs[idx];
  float f = hzGrado(g) * ((conOctava && T.oct == 12) ? 2.0f : 1.0f);
  float largo = entre(0.85f, 1.2f);
  for (int k = 0; k < 3; k++) {
    p.ph[k] = 0.0f; p.inc[k] = f * T.r[k] * INV_SR;
    p.e[k] = (p.inc[k] < 0.3f) ? T.a[k] : 0.0f;     // un parcial por encima de ~13 kHz no se toca
    p.d[k] = decaimiento(T.tau[k] * largo);
  }
  p.amp = amp; p.envio = T.envio; p.eco = T.eco; panear(pan, p.gL, p.gR); p.viva = true;
}

void tocarGota(Gota *pool, int n, float f, float subida, float tau, float amp, float pan, float envio) {
  int idx = 0; float menor = 1e9f;
  for (int i = 0; i < n; i++) {
    if (!pool[i].viva) { idx = i; break; }
    if (pool[i].env * pool[i].amp < menor) { menor = pool[i].env * pool[i].amp; idx = i; }
  }
  Gota &d = pool[idx];
  d.ph = 0.0f; d.f = f; d.fFin = f * subida; d.kSube = coefUnPolo(0.016f);
  d.env = 1.0f; d.d = decaimiento(tau); d.amp = amp; d.envio = envio; panear(pan, d.gL, d.gR); d.viva = true;
}

// Tambor de marco afinado en E2: dos envolventes (tono + golpe de ruido). La envolvente sube desde donde
// estaba (nunca salta) y un golpe nuevo nunca reinicia la fase.
void golpeTambor(float vel) {
  Golpe &t = tambor;
  t.atk = true; t.eObj = vel; t.incAtk = 1.0f / (0.0015f * SR);
  t.f = 82.41f * 1.22f; t.fFin = 82.41f; t.kF = coefUnPolo(0.035f);
  t.dT = decaimiento(0.20f); t.eN = vel; t.dN = decaimiento(0.007f); t.vivo = true;
}

// ─── Aves ────────────────────────────────────────────────────
static inline int limitarAve(int g) { return g < 24 ? 24 : (g > 34 ? 34 : g); }   // E6 … B7
void armarFrase(Ave &a, int especie, uint16_t tonos) {
  int g = 24 + azar(9);
  if (frnd() < 0.6f) g = ajustarATono(g, tonos);
  int n = 0;
  a.vib = 0.0f; a.trinoProf = 0.0f; a.trinoInc = 24.0f * INV_SR;
  switch (especie) {
    case E_SILBO:                                  // 2–3 notas largas silbadas, entran desde abajo
      n = 2 + azar(2);
      for (int i = 0; i < n; i++) {
        a.n[i] = NotaAve{ hzGrado(limitarAve(g)), entre(0.18f, 0.42f), 0.94f, 0.030f, entre(0.07f, 0.16f) };
        g += (frnd() < 0.5f ? -1 : 1) * (1 + azar(2)); if (g > 34) g -= 3; if (g < 24) g += 3;
      }
      a.vib = 0.006f;
      break;
    case E_FRASE:                                  // frase melódica tipo zorzal
      n = 4 + azar(4);
      for (int i = 0; i < n; i++) {
        a.n[i] = NotaAve{ hzGrado(limitarAve(g)), entre(0.06f, 0.15f), entre(0.88f, 1.10f), 0.008f, entre(0.02f, 0.06f) };
        int p = azar(5); g += (p == 0 ? -2 : p == 1 ? -1 : p == 2 ? 1 : p == 3 ? 2 : 0);
        if (g > 34) g -= 3; if (g < 24) g += 3;
      }
      if (frnd() < 0.3f) a.trinoProf = 0.5f;
      break;
    case E_TRINO:                                  // la misma nota muy rápida, que baja de a poco
      n = 8 + azar(9);
      for (int i = 0; i < n; i++) {
        a.n[i] = NotaAve{ hzGrado(limitarAve(g)), entre(0.026f, 0.036f), 1.10f, 0.004f, entre(0.016f, 0.024f) };
        if (i % 4 == 3) g -= 1;
      }
      break;
    default:                                       // GORJEO: chirridos que caen desde arriba
      n = 3 + azar(4);
      for (int i = 0; i < n; i++) {
        a.n[i] = NotaAve{ hzGrado(limitarAve(g)), entre(0.05f, 0.09f), 1.35f, 0.012f, entre(0.04f, 0.10f) };
        g -= 1 + azar(2); if (g < 24) g += 4;
      }
      break;
  }
  a.numNotas = n; a.nota = 0; a.especie = especie;
}
void empezarNotaAve(Ave &a) {
  const NotaAve &n = a.n[a.nota];
  a.fObj = n.f; a.f = n.f * n.desde; a.kGlide = coefUnPolo(n.glide);
  a.gate = 1.0f; a.t = n.dur; a.estado = 1;
}
void iniciarAve(Ave &a, int especie, float amp, float pan, float envio) {
  armarFrase(a, especie, ACORDES[acordeActual].tonos);
  a.amp = amp; a.envio = envio; panear(pan, a.gL, a.gR);
  empezarNotaAve(a);
}
float duracionFrase(const Ave &a) {
  float s = 0.0f;
  for (int i = 0; i < a.numNotas; i++) s += a.n[i].dur + a.n[i].gap;
  return s;
}
void avanzarAve(Ave &a, float dt) {
  if (a.estado == 1) {
    a.t -= dt;
    if (a.t <= 0.0f) { a.gate = 0.0f; a.estado = 2; a.t = a.n[a.nota].gap; }
  } else if (a.estado == 2) {
    a.t -= dt;
    if (a.t <= 0.0f) {
      a.nota++;
      if (a.nota < a.numNotas) empezarNotaAve(a); else a.estado = 0;
    }
  }
}

#if NUM_MUESTRAS > 0
void tocarMuestra() {
  int i = azar(NUM_MUESTRAS);
  if (NUM_MUESTRAS > 1) while (i == ultimaMuestra) i = azar(NUM_MUESTRAS);
  ultimaMuestra = i; muestraPub = i;
  int v = -1; uint32_t vieja = 0xFFFFFFFFu;
  for (int k = 0; k < NUM_VOCES_MUESTRA; k++) if (!vocesMuestra[k].viva) { v = k; break; }
  if (v < 0) {                                     // las tres sonando: la más vieja pasa a apagarse en 20 ms (sin clic)
    for (int k = 0; k < NUM_VOCES_MUESTRA; k++) if (vocesMuestra[k].edad < vieja) { vieja = vocesMuestra[k].edad; v = k; }
    saliendo[v] = vocesMuestra[v];
    saliendo[v].paso = -1.0f / (0.02f * SR);
  }
  VozMuestra &m = vocesMuestra[v];
  m.viva = true; m.idx = i; m.pos = 0; m.edad = ++edadMuestra; m.g = 1.0f; m.paso = 0.0f;
  adpcmIniciar(m.dec, MUESTRA_DATOS[i], 0);
}
#endif

// ==============================================================================================================================================
// ESCENA Y SECUENCIA
// ==============================================================================================================================================
static inline float densLocal(int c) { return clamp01((densS - CAPA_ENTRA[c]) / (1.0f - CAPA_ENTRA[c])); }
// Una nota de una capa con patrón suena si su prioridad < umbral: subir la densidad agrega notas en orden de
// importancia y nunca cambia las que ya sonaban (la idea del industrial_matriz)
static inline float umbral(int c) { return 0.12f + 1.05f * densLocal(c); }

void nuevaEscena() {
  int p = azar(NUM_PROG); if (prog >= 0) while (p == prog) p = azar(NUM_PROG);
  prog = p;
  int t = TEMPOS[azar(NUM_TEMPOS)]; while (t == bpm) t = TEMPOS[azar(NUM_TEMPOS)];
  bpm = t;
  largoPaso = SR * 60.0 / (bpm * 4.0);
  figuraArpa = azar(5);
  ritmoMelo = azar(NUM_RITMOS);
  numOnsets = 0;
  for (int s = 0; s < 32; s++) if (RITMOS_MELO[ritmoMelo][s] == 'x') numOnsets++;
  // contorno del motivo, en grados respecto de su ancla: pasos cortos, vuelve hacia el centro
  int c = 0; contorno[0] = 0;
  for (int k = 1; k < numOnsets; k++) {
    float r = frnd(); int st;
    if (c >= 3) st = -1 - azar(2);
    else if (c <= -3) st = 1 + azar(2);
    else if (r < 0.32f) st = -1; else if (r < 0.62f) st = 1; else if (r < 0.74f) st = -2;
    else if (r < 0.86f) st = 2; else if (r < 0.93f) st = 3; else st = 0;
    c += st; contorno[k] = c;
  }
  varIdx = numOnsets > 1 ? 1 + azar(numOnsets - 1) : 0; varDelta = frnd() < 0.5f ? -1 : 1;
  // prioridades (lo más importante de cada capa queda forzado: entra apenas entra la capa)
  for (int i = 0; i < 16; i++) {
    float w = i == 0 ? 1.0f : (i % 4 == 0) ? 0.85f : (i % 2 == 0) ? 0.60f : 0.42f;    // corcheas en 2 compases
    prioArpa[i] = (0.02f + frnd()) / w;
    float wk = PESO_KALIMBA[i] * entre(0.6f, 1.4f);
    prioKal[i] = (0.02f + frnd()) / wk;
    notaKal[i] = azar(6);
    prioTamb[i] = PESO_TAMBOR[i] > 0.0f ? (0.02f + frnd()) / PESO_TAMBOR[i] : 9.0f;
  }
  prioArpa[0] = 0.05f; prioTamb[0] = 0.05f;
  int mejor = 0; for (int i = 1; i < 16; i++) if (PESO_KALIMBA[i] > PESO_KALIMBA[mejor]) mejor = i;
  prioKal[mejor] = 0.05f;
  prioMelo[0] = 0.05f; prioMelo[2] = 0.30f; prioMelo[1] = 0.55f; prioMelo[3] = 0.80f;
  especieAmb[0] = azar(NUM_ESPECIES);
  do especieAmb[1] = azar(NUM_ESPECIES); while (especieAmb[1] == especieAmb[0]);
  // la PALETA: otros instrumentos (nunca la que sonaba). La primera escena es siempre BOSQUE.
  if (paleta < 0) paleta = 0;
  else { int q = azar(NUM_PALETAS); while (q == paleta) q = azar(NUM_PALETAS); paleta = q; }
  const InstrMelo &I = MELODIAS[PALETAS[paleta].melo];
  kMeloAtk = coefUnPolo(I.ataque);
  kMeloCaida = I.caida > 0.0f ? decaimiento(I.caida) : 1.0f;
  progPub = prog; bpmPub = bpm; figuraPub = figuraArpa; especiePub0 = especieAmb[0]; especiePub1 = especieAmb[1];
  paletaPub = paleta;
  escenaPub = escenaPub + 1;
}

VozPad &vozPadLibre() {
  int idx = 0; float menor = 1e9f;
  for (int i = 0; i < NUM_PAD; i++) {
    if (!pads[i].viva) return pads[i];
    if (pads[i].obj == 0.0f && pads[i].env < menor) { menor = pads[i].env; idx = i; }
  }
  return pads[idx];
}

void cambiarAcorde(int a) {
  acordeActual = a;
  const Acorde &A = ACORDES[a];
  const Paleta &P = PALETAS[paleta];
  // el anterior se apaga lento mientras entra el nuevo; en una escena nueva se va rápido, para que el cambio se sienta
  for (int i = 0; i < NUM_PAD; i++) { pads[i].obj = 0.0f; if (ataqueRapido) pads[i].kRel = kPadRelEscena; }
  const float PANES[4] = { -0.55f, 0.20f, -0.20f, 0.55f };
  const float desaf = P.desafPad * 0.000578f;                     // cents → razón
  for (int i = 0; i < 4; i++) {
    VozPad &p = vozPadLibre();
    float f = hzMidi(52.0f + P.octPad + A.pad[i]);
    p.inc1 = f * (1.0f + desaf) * INV_SR; p.inc2 = f * (1.0f - desaf) * INV_SR;
    if (!p.viva) { p.env = 0.0f; p.ph1 = frnd(); p.ph2 = frnd(); }  // una voz robada sigue su fase y sube desde donde estaba
    p.onda = P.onda; p.kAtk = ataqueRapido ? kPadAtkRapido : kPadAtk; p.kRel = kPadRel;
    p.obj = 1.0f; panear(PANES[i], p.gL, p.gR); p.viva = true;
  }
  ataqueRapido = false;
  for (int i = 0; i < NUM_BAJOS; i++) bajos[i].obj = 0.0f;
  int b = -1; float menor = 1e9f;
  for (int i = 0; i < NUM_BAJOS; i++) if (!bajos[i].viva) { b = i; break; }
  if (b < 0) for (int i = 0; i < NUM_BAJOS; i++) if (bajos[i].env < menor) { menor = bajos[i].env; b = i; }
  VozBajo &v = bajos[b];
  v.inc = hzMidi(40.0f + A.bajo) * INV_SR;
  if (!v.viva) { v.env = 0.0f; v.ph = 0.0f; }
  v.obj = 1.0f; v.viva = true;
}

void prepararMelodia(int ac) {
  meloEnAcorde = lvl[C_MELODIA] > 0.02f && prioMelo[ac] < umbral(C_MELODIA);
  onsetK = 0;
  if (!meloEnAcorde) { meloGate = 0.0f; return; }
  const Acorde &A = ACORDES[acordeActual];
  int ancla = ajustarATono(meloAncla, A.tonos);    // el tono del acorde más cerca del ancla anterior: conducción de voces
  while (ancla > 20) ancla -= 6;
  while (ancla < 14) ancla += 6;
  meloAncla = ancla;
  const char *r = RITMOS_MELO[ritmoMelo];
  int k = 0;
  for (int s = 0; s < 32 && k < 16; s++) {
    if (r[s] != 'x') continue;
    int largo = 1; while (s + largo < 32 && r[s + largo] == '-') largo++;
    int g = ancla + contorno[k];
    if ((ac & 1) && k == varIdx) g += varDelta;  // 2º y 4º acorde: el motivo varía una nota
    if (g > 25) g -= 6; if (g < 12) g += 6;
    if ((s & 3) == 0 || largo >= 6) g = ajustarATono(g, A.tonos);   // tiempos fuertes y notas largas: nota del acorde
    if (ac == 3 && k == numOnsets - 1) g = gradoDePc(g, A.bajo);    // fin del ciclo: cierra en la fundamental
    notasMotivo[k++] = g;
  }
}

void pasoMelodia(int s32) {
  if (!meloEnAcorde) return;
  char c = RITMOS_MELO[ritmoMelo][s32];
  if (c == 'x') {
    int g = notasMotivo[onsetK < 16 ? onsetK : 15]; onsetK++;
    const InstrMelo &I = MELODIAS[PALETAS[paleta].melo];
    meloObj = hzGrado(g) * (I.oct == 12 ? 2.0f : 1.0f);
    bool ligar = meloGate > 0.5f && I.caida == 0.0f;               // la celesta no liga: cada nota es un golpe
    if (ligar) meloKG = coefUnPolo(0.045f);                        // legato: liga con un glissando corto
    else { meloKG = 1.0f; meloF = meloObj; }
    meloGate = 1.0f; meloT = 0.0f; meloCae = 1.0f;
  } else if (c == '.') meloGate = 0.0f;
}

void alPaso() {
  paso = (paso + 1) & 127;
  int s32 = paso & 31, ac = paso >> 5, s16 = paso & 15;
  if (s32 == 0) { cambiarAcorde(PROGRESIONES[prog][ac]); prepararMelodia(ac); }
  if ((paso & 3) == 0) pulsoPub = pulsoPub + 1;
  const Acorde &A = ACORDES[acordeActual];
  const float mus = mgS * fade;
  int lista[16];
  // ARPA en corcheas, sobre las notas del acorde de E3 a E5
  if (!(paso & 1) && lvl[C_ARPA] > 0.02f) {
    int pos = s32 >> 1;
    if (prioArpa[pos] < umbral(C_ARPA)) {
      int n = tonosEnRango(6, 18, A.tonos, lista);
      int i = 0;
      switch (figuraArpa) {
        case 0: i = pos % n; break;                                                     // sube
        case 1: { int p = 2 * (n - 1); int k = p > 0 ? pos % p : 0; i = k < n ? k : p - k; } break;   // ola
        case 2: { int k = pos % (2 * n); i = (k & 1) ? (k / 2 + 2) % n : (k / 2) % n; } break;      // saltos
        case 3: i = n - 1 - pos % n; break;                                             // cascada
        default: i = (pos * 3) % n; break;                                              // campana
      }
      float vel = (pos == 0 ? 1.0f : (pos & 1) ? 0.62f : 0.80f) * entre(0.85f, 1.0f);
      float pan = -0.6f + 1.2f * i / (n > 1 ? n - 1 : 1);
      int ta = PALETAS[paleta].arpa;
      if (ta < 0) tocarArpa(lista[i], vel, NIVEL_ARPA * lvl[C_ARPA] * mus, pan);                 // arpa de cuerda
      else tocarPerc(ta, lista[i], NIVEL_KALIMBA * 1.3f * vel * lvl[C_ARPA] * mus, pan, true);   // marimba, caja de música…
    }
  }
  // KALIMBA (o el timbre de la paleta) en semicorcheas, ostinato sincopado arriba
  if (lvl[C_KALIMBA] > 0.02f && prioKal[s16] < umbral(C_KALIMBA)) {
    int n = tonosEnRango(16, 25, A.tonos, lista);
    if (n > 0) tocarPerc(PALETAS[paleta].kal, lista[notaKal[s16] % n], NIVEL_KALIMBA * lvl[C_KALIMBA] * mus * entre(0.75f, 1.0f), entre(-0.5f, 0.5f), false);
  }
  if (lvl[C_TAMBOR] > 0.02f && prioTamb[s16] < umbral(C_TAMBOR))
    golpeTambor(NIVEL_TAMBOR * lvl[C_TAMBOR] * mus * (s16 == 0 ? 1.0f : 0.7f));
  pasoMelodia(s32);
}

// Una campanita en la fundamental del acorde (Play y BTN2: el botón se oye en el acto)
void campanitaTonica() {
  int g = gradoDePc(20, ACORDES[acordeActual].bajo);
  tocarCampana(g, NIVEL_CAMPANA * 1.3f, 0.0f, 0.6f);
}

void arrancar() {
  tocando = true; tocandoPub = true;
  paso = -1; faltan = 0.0;
  acordeActual = PROGRESIONES[prog][0];
  campanitaTonica();
}
void parar() {
  tocando = false; tocandoPub = false;
  for (int i = 0; i < NUM_PAD; i++) pads[i].obj = 0.0f;
  for (int i = 0; i < NUM_BAJOS; i++) bajos[i].obj = 0.0f;
  meloGate = 0.0f; meloEnAcorde = false;
}

void aplicarPedidos() {
  if (vPlay != pedPlay) { vPlay = pedPlay; mezclarSemilla(entropia); if (tocando) parar(); else arrancar(); }
  if (vEscena != pedEscena) {
    vEscena = pedEscena; mezclarSemilla(entropia);
    nuevaEscena();
    if (tocando) { paso = -1; faltan = 0.0; ataqueRapido = true; meloGate = 0.0f; }   // entra en el acto, desde el primer acorde
    acordeActual = PROGRESIONES[prog][0];
    campanitaTonica();
  }
  if (vAve != pedAve) {
    vAve = pedAve; mezclarSemilla(entropia);
    Ave &a = aves[AVE_CERCA];
    int e = azar(NUM_ESPECIES); if (e == a.especie) e = (e + 1 + azar(NUM_ESPECIES - 1)) % NUM_ESPECIES;
    iniciarAve(a, e, NIVEL_AVE_CERCA, entre(-0.3f, 0.3f), 0.25f);
    if (tocando && aves[0].estado == 0) {          // otra le contesta desde lejos con su mismo canto
      respPend = true; respEspecie = e; esperaAve[0] = duracionFrase(a) + entre(0.3f, 1.0f);
    }
  }
  if (vRafaga != pedRafaga) {
    vRafaga = pedRafaga; mezclarSemilla(entropia);
    rafHold = 0.5f;                                // un viento SIN sonido: sólo despierta las campanitas del bosque
    cascRestan = 8 + azar(5); cascT = 0.0f; cascGrado = 24 + azar(4); cascAmp = 1.0f; cascPan = entre(-0.6f, 0.6f);
  }
  if (vMuestra != pedMuestra) {
    vMuestra = pedMuestra; mezclarSemilla(entropia);
#if NUM_MUESTRAS > 0
    tocarMuestra();
#else
    lluviaRestan = 7 + azar(5); lluviaT = 0.0f; crecida = 1.0f;
#endif
  }
}

// ==============================================================================================================================================
// CONTROL POR BLOQUE: perillas, ganancias de las capas y agendas del bosque
// ==============================================================================================================================================
void actualizarBloque() {
  const float kP = 0.035f;                         // ~80 ms: el ruido del ADC no llega al audio
  balS  += (potBal  - balS)  * kP;
  densS += (potDens - densS) * kP;
  fade  += ((tocando ? 1.0f : 0.0f) - fade) * (tocando ? 0.0036f : 0.0019f);   // entra en ~0.8 s, se va en ~1.5 s
  ngS = clamp01(2.0f * balS); mgS = clamp01(2.0f * (1.0f - balS));            // POT2 a la derecha = más naturaleza
  // el pad cambia de color con la paleta, sin salto: el corte camina hacia el nuevo
  padCorteS += (PALETAS[paleta].cortePad - padCorteS) * 0.02f;
  coefFiltro(padFL, padCorteS, 0.6f); coefFiltro(padFR, padCorteS, 0.6f);
  for (int c = 0; c < NUM_CAPAS; c++) { float x = clamp01((densS - CAPA_ENTRA[c]) / CAPA_ANCHO); lvl[c] = x * x * (3.0f - 2.0f * x); }
  gPad  = NIVEL_PAD  * lvl[C_PAD]  * mgS * fade;
  gBajo = NIVEL_BAJO * lvl[C_BAJO] * mgS * fade;
  gMelo = NIVEL_MELO * lvl[C_MELODIA] * mgS * fade;

  // ─ viento: un paseo lento de ráfagas + BTN4 ─
  gustT -= DT_BLOQUE;
  if (gustT <= 0.0f) { gustObj = frnd() < 0.3f ? entre(0.05f, 0.15f) : entre(0.2f, 0.9f); gustT = entre(2.0f, 6.0f); }
  gust += (gustObj - gust) * 0.003f;
  if (rafHold > 0.0f) { rafHold -= DT_BLOQUE; rafEnv += (1.0f - rafEnv) * kRafUp; }
  else rafEnv += (0.0f - rafEnv) * kRafDown;
  gViento = NIVEL_VIENTO * ngS * fade * (0.25f + 0.75f * gust);
  float fcV = 260.0f + 700.0f * gust;
  kViento = 1.0f - expf(-2.0f * PI_F * fcV * INV_SR);

  // ─ vertiente: los paso-banda se mueven un poco y el caudal respira ─
  crecida *= 0.9985f;                              // la crecida de BTN5 baja en ~2 s
  gVert = NIVEL_VERTIENTE * (ngS * fade + 0.9f * crecida);
  if (gVert > 1e-4f) {
    for (int b = 0; b < 3; b++) {
      vJit[b] += (frnd() * 2.0f - 1.0f) * 0.035f - vJit[b] * 0.04f;
      vCaudal[b] += ((0.55f + 0.45f * frnd()) - vCaudal[b]) * 0.06f;
      float fc = V_FC[b] * (1.0f + vJit[b]);
      bqBPF(vBP[0][b], fc, V_Q[b]); bqBPF(vBP[1][b], fc * 1.07f, V_Q[b]);
    }
    if (frnd() < (12.0f + 18.0f * crecida) * DT_BLOQUE)   // burbujas
      tocarGota(burbujas, NUM_BURBUJAS, entre(260.0f, 900.0f), 1.8f, 0.010f, 0.05f * gVert / NIVEL_VERTIENTE, entre(-0.8f, 0.8f), 0.1f);
  }

  // ─ vertiente grabada continua (POT4): tiene su propio volumen, no depende del balance; entra y sale con Play ─
  gContPrev = gCont;
  const float pv = potVert;
  const float gContObj = pv < 0.01f ? 0.0f : NIVEL_CONTINUA * pv * sqrtf(pv) * fade;
  gCont += (gContObj - gCont) * 0.05f;               // y además se interpola muestra a muestra dentro del bloque

  // ─ el bosque y la música que no van en el secuenciador (sólo tocando) ─
  const uint16_t tonos = ACORDES[acordeActual].tonos;
  if (tocando) {
    if (lvl[C_CAMPANAS] > 0.02f) {
      tCamp -= DT_BLOQUE;
      if (tCamp <= 0.0f) {
        int g = 18 + azar(9); if (frnd() < 0.7f) g = ajustarATono(g, tonos);
        tocarCampana(g, NIVEL_CAMPANA * lvl[C_CAMPANAS] * mgS * fade * entre(0.4f, 1.0f), entre(-0.7f, 0.7f), 0.7f);
        float dl = densLocal(C_CAMPANAS);
        // ALGUNAS campanitas: a veces un racimo de dos o tres, y mucho aire entre ellos
        tCamp = frnd() < 0.25f ? entre(0.10f, 0.35f) : entre(1.2f, 6.0f) / (0.5f + 1.2f * dl);
        if (rafEnv > 0.3f || gust > 0.75f) tCamp *= 0.5f;            // el viento las hace sonar
      }
    }
    if (lvl[C_GOTAS] > 0.02f) {
      tGota -= DT_BLOQUE;
      if (tGota <= 0.0f) {
        int g = 18 + azar(7);
        tocarGota(gotas, NUM_GOTAS, hzGrado(g), 1.6f, entre(0.05f, 0.09f), NIVEL_GOTA * lvl[C_GOTAS] * mgS * fade, entre(-0.8f, 0.8f), 0.5f);
        tGota = entre(0.4f, 2.6f) / (0.5f + 1.5f * densLocal(C_GOTAS));
      }
    }
    int nAves = lvl[C_CORO] > 0.5f ? 3 : 2;
    for (int b = 0; b < 3; b++) {
      Ave &a = aves[b];
      if (a.estado != 0) continue;
      bool contesta = (b == 0 && respPend);
      if (!contesta && (b >= nAves || lvl[C_AVES] <= 0.02f)) continue;
      esperaAve[b] -= DT_BLOQUE;
      if (esperaAve[b] > 0.0f) continue;
      if (contesta) {
        respPend = false;
        iniciarAve(a, respEspecie, NIVEL_AVE * 0.8f * ngS * fade, b == 0 ? -0.75f : 0.75f, 0.6f);
      } else {
        iniciarAve(a, especieAmb[b & 1], NIVEL_AVE * entre(0.35f, 1.0f) * lvl[C_AVES] * ngS * fade, entre(-0.85f, 0.85f), entre(0.3f, 0.8f));
      }
      float dl = densLocal(C_AVES) + lvl[C_CORO];
      esperaAve[b] = entre(1.5f, 7.0f) / (0.5f + 1.5f * dl);
    }
  }
  for (int b = 0; b < NUM_AVES; b++) avanzarAve(aves[b], DT_BLOQUE);
  {                                                  // el ave de la pantalla canta con la de BTN3
    static int notaAnt = -1, estadoAnt = 0;
    const Ave &a = aves[AVE_CERCA];
    if (a.estado == 1 && (estadoAnt != 1 || a.nota != notaAnt)) aveNotaPub = aveNotaPub + 1;
    aveCantaPub = (a.estado == 1); estadoAnt = a.estado; notaAnt = a.nota;
  }

  // ─ cascada de campanitas (BTN4) y lluvia de gotas (BTN5 sin muestras): suenan aunque esté parado ─
  if (cascRestan > 0) {
    cascT -= DT_BLOQUE;
    if (cascT <= 0.0f) {
      int g = frnd() < 0.85f ? ajustarATono(cascGrado, tonos) : cascGrado;   // casi siempre notas del acorde: suena a acorde
      tocarCampana(g, NIVEL_CASCADA * cascAmp * entre(0.8f, 1.0f), cascPan, 0.6f);
      cascGrado -= 1 + azar(2); if (cascGrado < 17) cascGrado += 5;
      cascPan += entre(-0.3f, 0.3f); if (cascPan > 0.8f) cascPan = 0.8f; if (cascPan < -0.8f) cascPan = -0.8f;
      cascAmp *= 0.95f; cascT = entre(0.07f, 0.18f); cascRestan--;
    }
  }
  if (lluviaRestan > 0) {
    lluviaT -= DT_BLOQUE;
    if (lluviaT <= 0.0f) {
      int g = ajustarATono(18 + azar(8), tonos);
      tocarGota(gotas, NUM_GOTAS, hzGrado(g), 1.6f, entre(0.05f, 0.10f), NIVEL_GOTA * 1.4f * entre(0.6f, 1.0f), entre(-0.8f, 0.8f), 0.55f);
      lluviaT = entre(0.06f, 0.22f); lluviaRestan--;
    }
  }
}

// ==============================================================================================================================================
// RENDER (por tramo: el bloque se corta justo en cada paso del secuenciador)
// ==============================================================================================================================================
IRAM_ATTR void renderPad(int o, int n) {
  const float g = gPad;
  for (int v = 0; v < NUM_PAD; v++) {
    VozPad &p = pads[v];
    if (!p.viva) continue;
    float ph1 = p.ph1, ph2 = p.ph2, env = p.env;
    // bajo −48 dB la cola pasa a un tau de 60 ms: inaudible bajo la reverb y libera la voz en vez de tenerla 20 s ocupada
    const float obj = p.obj, k = obj > env ? p.kAtk : (obj == 0.0f && env < 0.004f ? kPadFin : p.kRel), i1 = p.inc1, i2 = p.inc2, gl = p.gL * g, gr = p.gR * g;
    const float *t = ONDA_PAD[p.onda];
    for (int i = o; i < o + n; i++) {
      env += (obj - env) * k;
      float s = (ondaPad(t, ph1) + ondaPad(t, ph2)) * env;
      ph1 += i1; if (ph1 >= 1.0f) ph1 -= 1.0f;
      ph2 += i2; if (ph2 >= 1.0f) ph2 -= 1.0f;
      pL[i] += s * gl; pR[i] += s * gr;
    }
    p.ph1 = ph1; p.ph2 = ph2; p.env = env;
    if (obj == 0.0f && env < 3e-4f) p.viva = false;     // −70 dB
  }
}

IRAM_ATTR void renderBajo(int o, int n) {
  const float g = gBajo;
  for (int v = 0; v < NUM_BAJOS; v++) {
    VozBajo &b = bajos[v];
    if (!b.viva) continue;
    float ph = b.ph, env = b.env;
    const float obj = b.obj, k = obj > env ? kBajoAtk : (obj == 0.0f && env < 0.004f ? kPadFin : kBajoRel), inc = b.inc;
    for (int i = o; i < o + n; i++) {
      env += (obj - env) * k;
      float s = (seno(ph) + 0.22f * seno(frac1(ph * 2.0f)) + 0.07f * seno(frac1(ph * 3.0f))) * env * g;
      ph += inc; if (ph >= 1.0f) ph -= 1.0f;
      mL[i] += s; mR[i] += s; sL[i] += s * 0.10f; sR[i] += s * 0.10f;
    }
    b.ph = ph; b.env = env;
    if (obj == 0.0f && env < 3e-4f) b.viva = false;
  }
}

IRAM_ATTR void renderMelodia(int o, int n) {
  if (meloEnv < 1e-5f && meloGate == 0.0f) return;
  const InstrMelo &I = MELODIAS[PALETAS[paleta].melo];
  const float g = gMelo, gate = meloGate, kc = kMeloCaida;
  // vibrato que entra ~0.25 s después del ataque
  float vib = meloT > 0.25f ? I.vib * clamp01((meloT - 0.25f) / 0.4f) : 0.0f;
  float f = meloF, env = meloEnv, ph = meloPh, vph = meloVibPh, hp = meloHp, cae = meloCae;
  const float obj = meloObj, kg = meloKG, ivib = 5.2f * INV_SR, h2 = I.h2, h3 = I.h3, h5 = I.h5, soplo = I.soplo;
  const float gl = 0.92f * g, gr = 0.80f * g;
  for (int i = o; i < o + n; i++) {
    f += (obj - f) * kg;
    cae *= kc;                                       // celesta: la nota se apaga sola aunque siga "apretada"
    float objEnv = gate * cae;
    env += (objEnv - env) * (objEnv > env ? kMeloAtk : kMeloRel);
    float fv = f * (1.0f + vib * seno(vph));
    vph += ivib; if (vph >= 1.0f) vph -= 1.0f;
    ph += fv * INV_SR; if (ph >= 1.0f) ph -= 1.0f;
    float tono = seno(ph) + h2 * seno(frac1(ph * 2.0f)) + h3 * seno(frac1(ph * 3.0f)) + h5 * seno(frac1(ph * 5.0f));
    float r = ruido(semRuidoL); hp += 0.25f * (r - hp);              // soplo: ruido con los graves quitados
    float s = (tono + soplo * (r - hp)) * env;
    mL[i] += s * gl; mR[i] += s * gr;
    sL[i] += s * gl * 0.45f; sR[i] += s * gr * 0.45f; ecoIn[i] += s * g * 0.30f;
  }
  if (cae < 1e-5f) cae = 0.0f;
  meloF = f; meloEnv = env; meloPh = ph; meloVibPh = vph; meloHp = hp; meloCae = cae;
  meloT += n * INV_SR;
}

// Un parcial senoidal con decaimiento exponencial, sumado sobre el tramo (parcial por parcial: sin ramas por muestra)
float tmpParc[BUFFER_SAMPLES];
static inline void sumarParcial(int o, int n, float &ph, float inc, float &e, float d) {
  float p = ph, en = e;
  for (int i = o; i < o + n; i++) {
    tmpParc[i] += seno(p) * en;
    p += inc; if (p >= 1.0f) p -= 1.0f;
    en *= d;
  }
  ph = p; e = en;
}

IRAM_ATTR void renderCampanas(int o, int n) {
  for (int v = 0; v < NUM_CAMPANAS; v++) {
    Campana &c = campanas[v];
    if (!c.viva) continue;
    for (int i = o; i < o + n; i++) tmpParc[i] = 0.0f;
    for (int k = 0; k < 4; k++) if (c.inc[k] > 0.0f) sumarParcial(o, n, c.ph[k], c.inc[k], c.e[k], c.d[k]);
    const float gl = c.gL * c.amp, gr = c.gR * c.amp, ev = c.envio, ec = c.amp * 0.18f;
    for (int i = o; i < o + n; i++) {
      float s = tmpParc[i];
      mL[i] += s * gl; mR[i] += s * gr;
      sL[i] += s * gl * ev; sR[i] += s * gr * ev; ecoIn[i] += s * ec;
    }
    for (int k = 1; k < 4; k++) if (c.e[k] < 1e-5f) { c.e[k] = 0.0f; c.inc[k] = 0.0f; }   // parcial muerto: no se calcula más
    if (c.e[0] < 1e-3f) c.viva = false;                  // −60 dB bajo su golpe (≈ −80 dBFS): ya no se oye
  }
}

IRAM_ATTR void renderArpas(int o, int n) {
  for (int v = 0; v < NUM_ARPAS; v++) {
    Arpa &a = arpas[v];
    if (!a.viva) continue;
    float prev = a.prev, apX = a.apX, apY = a.apY, pico = 0.0f;
    const float c = a.c, perd = a.perdida * 0.5f, gl = a.gL * a.amp, gr = a.gR * a.amp;
    int pos = a.pos; const int L = a.largo;
    for (int i = o; i < o + n; i++) {
      float y = a.buf[pos];
      float x = (y + prev) * perd; prev = y;
      float w = c * (x - apY) + apX; apX = x; apY = w;
      a.buf[pos] = w; if (++pos >= L) pos = 0;
      mL[i] += y * gl; mR[i] += y * gr;
      sL[i] += y * gl * 0.40f; sR[i] += y * gr * 0.40f; ecoIn[i] += y * a.amp * 0.10f;
      float m = fabsf(y); if (m > pico) pico = m;
    }
    a.prev = prev; a.apX = apX; a.apY = apY; a.pos = pos; a.nivel = pico;
    if (pico < 3e-5f) a.viva = false;
  }
}

IRAM_ATTR void renderPercs(int o, int n) {
  for (int v = 0; v < NUM_PERCS; v++) {
    Perc &p = percs[v];
    if (!p.viva) continue;
    const float gl = p.gL * p.amp, gr = p.gR * p.amp, ev = p.envio, ec = p.amp * p.eco;
    for (int i = o; i < o + n; i++) tmpParc[i] = 0.0f;
    for (int k = 0; k < 3; k++) if (p.e[k] > 0.0f) sumarParcial(o, n, p.ph[k], p.inc[k], p.e[k], p.d[k]);
    for (int i = o; i < o + n; i++) {
      float s = tmpParc[i];
      mL[i] += s * gl; mR[i] += s * gr;
      sL[i] += s * gl * ev; sR[i] += s * gr * ev; ecoIn[i] += s * ec;
    }
    for (int k = 1; k < 3; k++) if (p.e[k] < 1e-5f) p.e[k] = 0.0f;   // parcial muerto: no se calcula más
    if (p.e[0] < 1e-3f) p.viva = false;
  }
}

IRAM_ATTR void renderGotas(Gota *pool, int num, int o, int n) {
  for (int v = 0; v < num; v++) {
    Gota &d = pool[v];
    if (!d.viva) continue;
    const float gl = d.gL * d.amp, gr = d.gR * d.amp;
    for (int i = o; i < o + n; i++) {
      d.f += (d.fFin - d.f) * d.kSube;              // la gota sube de tono: eso la hace gota
      d.ph += d.f * INV_SR; if (d.ph >= 1.0f) d.ph -= 1.0f;
      float s = seno(d.ph) * d.env; d.env *= d.d;
      mL[i] += s * gl; mR[i] += s * gr;
      sL[i] += s * gl * d.envio; sR[i] += s * gr * d.envio; ecoIn[i] += s * d.amp * d.envio * 0.8f;
    }
    if (d.env < 1e-4f) d.viva = false;
  }
}

IRAM_ATTR void renderAves(int o, int n) {
  for (int v = 0; v < NUM_AVES; v++) {
    Ave &a = aves[v];
    if (a.estado == 0 && a.env < 1e-4f) continue;
    float f = a.f, env = a.env, ph = a.ph, vph = a.vibPh, tph = a.trinoPh;
    const float obj = a.fObj, kg = a.kGlide, gate = a.gate, k = gate > env ? kAveAtk : kAveRel;
    const float vib = a.vib, prof = a.trinoProf, tinc = a.trinoInc, ivib = 5.5f * INV_SR;
    const float gl = a.gL * a.amp, gr = a.gR * a.amp, env2 = a.envio;
    for (int i = o; i < o + n; i++) {
      f += (obj - f) * kg;
      env += (gate - env) * k;
      float fv = f;
      if (vib > 0.0f) { fv *= 1.0f + vib * seno(vph); vph += ivib; if (vph >= 1.0f) vph -= 1.0f; }
      ph += fv * INV_SR; if (ph >= 1.0f) ph -= 1.0f;
      float am = 1.0f;
      if (prof > 0.0f) { am = 1.0f - prof * (0.5f + 0.5f * seno(tph)); tph += tinc; if (tph >= 1.0f) tph -= 1.0f; }
      float s = seno(ph) * env * am;
      mL[i] += s * gl; mR[i] += s * gr;
      sL[i] += s * gl * env2; sR[i] += s * gr * env2;
    }
    a.f = f; a.env = env; a.ph = ph; a.vibPh = vph; a.trinoPh = tph;
  }
}

IRAM_ATTR void renderGolpes(int o, int n) {
  Golpe &t = tambor;
  if (t.vivo) {
    for (int i = o; i < o + n; i++) {
      if (t.atk) {                               // sube desde donde estaba; si ya estaba más arriba, no salta hacia abajo
        if (t.eT < t.eObj) { t.eT += t.incAtk; if (t.eT >= t.eObj) { t.eT = t.eObj; t.atk = false; } } else t.atk = false;
      } else t.eT *= t.dT;
      t.f += (t.fFin - t.f) * t.kF;
      t.ph += t.f * INV_SR; if (t.ph >= 1.0f) t.ph -= 1.0f;
      float r = ruido(semRuidoR); t.lp += 0.08f * (r - t.lp);         // golpe de la mano: ruido grave y corto
      float s = seno(t.ph) * t.eT + t.lp * t.eN * 1.6f; t.eN *= t.dN;
      mL[i] += s; mR[i] += s; sL[i] += s * 0.15f; sR[i] += s * 0.15f;
    }
    if (t.eN < 1e-5f) t.eN = 0.0f;
    if (!t.atk && t.eT < 1e-4f && t.eN < 1e-4f) t.vivo = false;
  }
}

IRAM_ATTR void renderVertiente(int o, int n) {
  if (gVert < 1e-4f) return;
  const float g = gVert, c0 = vCaudal[0] * V_GAN[0], c1 = vCaudal[1] * V_GAN[1], c2 = vCaudal[2] * V_GAN[2];
  for (int i = o; i < o + n; i++) {
    float nl = ruido(semRuidoL), nr = ruido(semRuidoR);
    vRumL += 0.025f * (nl - vRumL); vRumR += 0.025f * (nr - vRumR);   // el retumbe grave del agua
    float l = pasoBQ(vBP[0][0], nl) * c0 + pasoBQ(vBP[0][1], nl) * c1 + pasoBQ(vBP[0][2], nl) * c2 + vRumL * 0.9f;
    float r = pasoBQ(vBP[1][0], nr) * c0 + pasoBQ(vBP[1][1], nr) * c1 + pasoBQ(vBP[1][2], nr) * c2 + vRumR * 0.9f;
    mL[i] += l * g; mR[i] += r * g; sL[i] += l * g * 0.10f; sR[i] += r * g * 0.10f;
  }
}

IRAM_ATTR void renderViento(int o, int n) {
  if (gViento < 1e-4f) return;
  const float g = gViento * 3.0f, k = kViento;
  for (int i = o; i < o + n; i++) {
    float nl = ruido(semRuidoL), nr = ruido(semRuidoR);
    vtL1 += k * (nl - vtL1); vtL2 += k * (vtL1 - vtL2);
    vtR1 += k * (nr - vtR1); vtR2 += k * (vtR1 - vtR2);
    float l = vtL2 * g, r = vtR2 * g;
    mL[i] += l; mR[i] += r; sL[i] += l * 0.25f; sR[i] += r * 0.25f;
  }
}

IRAM_ATTR void renderMuestras(int o, int n) {
#if NUM_MUESTRAS > 0
  const float esc = NIVEL_MUESTRA / 32768.0f;
  for (int v = 0; v < 2 * NUM_VOCES_MUESTRA; v++) {
    VozMuestra &m = v < NUM_VOCES_MUESTRA ? vocesMuestra[v] : saliendo[v - NUM_VOCES_MUESTRA];
    if (!m.viva) continue;
    const uint32_t largo = MUESTRA_LARGO[m.idx];
    for (int i = o; i < o + n; i++) {
      if (m.paso < 0.0f) { m.g += m.paso; if (m.g <= 0.0f) { m.viva = false; break; } }
      float s = adpcmSig(m.dec) * esc * m.g;
      mL[i] += s; mR[i] += s; sL[i] += s * 0.25f; sR[i] += s * 0.25f;
      if (++m.pos >= largo) { m.viva = false; break; }   // el sample trae su fundido final
    }
  }
#else
  (void)o; (void)n;
#endif
}

// ─── Vertiente continua (POT4) ───────────────────────────────
// Una grabación de 6 s no puede sonar en bucle: la vuelta se oye. Cada canal lee trozos de 1–2 s tomados al azar de
// la grabación y los empalma con un fundido de potencia constante (cos/sen) de 0.35 s; L y R eligen trozos distintos,
// así la vertiente queda ancha y nunca se repite igual. Cada trozo empieza al comienzo de un bloque ADPCM (23 ms).
#ifdef CONTINUA_LARGO
const int      EMPALME = (int)(EMPALME_S * SAMPLE_RATE);
const uint32_t BLOQUE_MAX = (CONTINUA_LARGO - (uint32_t)((GRANO_MAX_S + 2.0f * EMPALME_S) * SAMPLE_RATE) - 2) / ADPCM_BLOQUE;
static inline void nuevoTrozo(Adpcm &h) { adpcmIniciar(h, CONTINUA_DATOS, (uint32_t)(frnd() * BLOQUE_MAX)); }
void iniciarLector(Lector &l) {
  l.cur = 0; nuevoTrozo(l.h[0]); nuevoTrozo(l.h[1]); l.xf = -1;
  l.restante = (int)(entre(GRANO_MIN_S, GRANO_MAX_S) * SAMPLE_RATE);
}
static inline float leerContinua(Lector &l) {
  float a = adpcmSig(l.h[l.cur]);
  if (l.xf < 0) {
    if (--l.restante <= 0) { nuevoTrozo(l.h[l.cur ^ 1]); l.xf = 0; }   // empieza el empalme
    return a;
  }
  float b = adpcmSig(l.h[l.cur ^ 1]);
  float t = (float)l.xf / EMPALME;
  float s = a * seno(0.25f + 0.25f * t) + b * seno(0.25f * t);     // cos·a + sen·b: la potencia no se hunde
  if (++l.xf >= EMPALME) { l.cur ^= 1; l.xf = -1; l.restante = (int)(entre(GRANO_MIN_S, GRANO_MAX_S) * SAMPLE_RATE); }
  return s;
}
#endif
IRAM_ATTR void renderContinua(int o, int n) {
#ifdef CONTINUA_LARGO
  if (gCont < 1e-4f && gContPrev < 1e-4f) return;
  const float esc = 1.0f / 32768.0f, paso = (gCont - gContPrev) / BUFFER_SAMPLES;
  float g = gContPrev + paso * o;
  for (int i = o; i < o + n; i++) {
    float l = leerContinua(lecL) * esc * g, r = leerContinua(lecR) * esc * g;
    mL[i] += l; mR[i] += r; sL[i] += l * 0.08f; sR[i] += r * 0.08f;
    g += paso;
  }
#else
  (void)o; (void)n;
#endif
}

void renderTramo(int o, int n) {
  renderPad(o, n);
  renderBajo(o, n);
  renderMelodia(o, n);
  renderCampanas(o, n);
  renderArpas(o, n);
  renderPercs(o, n);
  renderGotas(gotas, NUM_GOTAS, o, n);
  renderGotas(burbujas, NUM_BURBUJAS, o, n);
  renderAves(o, n);
  renderGolpes(o, n);
  renderVertiente(o, n);
  renderViento(o, n);
  renderMuestras(o, n);
  renderContinua(o, n);
}

// ==============================================================================================================================================
// ESPACIO Y SALIDA
// ==============================================================================================================================================
IRAM_ATTR void procesarBloque(int16_t *salida) {
  aplicarPedidos();
  actualizarBloque();
  memset(mL, 0, sizeof(mL)); memset(mR, 0, sizeof(mR));
  memset(pL, 0, sizeof(pL)); memset(pR, 0, sizeof(pR));
  memset(sL, 0, sizeof(sL)); memset(sR, 0, sizeof(sR));
  memset(ecoIn, 0, sizeof(ecoIn));

  int o = 0;
  while (o < BUFFER_SAMPLES) {
    int n = BUFFER_SAMPLES - o;
    if (tocando) {
      if (faltan <= 0.0) { alPaso(); faltan += largoPaso; }
      int hasta = (int)ceil(faltan);
      if (hasta < n) n = hasta;
      if (n < 1) n = 1;
    }
    renderTramo(o, n);
    if (tocando) faltan -= n;
    o += n;
  }

  // ESPACIO fijo: cuánto va a la reverb y al eco
  const float esp = ESPACIO * ESPACIO * (3.0f - 2.0f * ESPACIO);
  const float envRev = esp * 0.25f, envEco = esp * 0.9f;
  const float volObj = potVol;
  for (int i = 0; i < BUFFER_SAMPLES; i++) {
    // pad: coro lejano, sin brillo
    float pl = pasoLP(padFL, pL[i]), pr = pasoLP(padFR, pR[i]);
    float l = mL[i] + pl, r = mR[i] + pr;
    float xs = (sL[i] + sR[i] + (pl + pr) * 0.55f) * envRev + 1e-18f;

    // eco ping-pong (fijo, oscuro en la realimentación)
    float dl = ecoBufL[ecoPos] * (1.0f / 8192.0f), dr = ecoBufR[ecoPos] * (1.0f / 8192.0f);
    ecoLp += 0.35f * (dr * ECO_FB + DITHER - ecoLp);
    float wl = ecoIn[i] * envEco + ecoLp;
    int32_t qL = (int32_t)(wl * 8192.0f), qR = (int32_t)(dl * 8192.0f);
    ecoBufL[ecoPos] = (int16_t)(qL > 32767 ? 32767 : qL < -32768 ? -32768 : qL);
    ecoBufR[ecoPos] = (int16_t)(qR > 32767 ? 32767 : qR < -32768 ? -32768 : qR);
    if (++ecoPos >= ECO_LARGO) ecoPos = 0;
    xs += (dl + dr) * 0.12f;                     // los ecos también se van al bosque

    // reverb: 2 pasa-todos de difusión → FDN de 4 líneas (Hadamard) con amortiguación
    float b1 = rvAp1[rvP1], y1 = b1 - 0.6f * xs; rvAp1[rvP1] = xs + 0.6f * y1; if (++rvP1 >= RV_AP1) rvP1 = 0;
    float b2 = rvAp2[rvP2], y2 = b2 - 0.6f * y1; rvAp2[rvP2] = y1 + 0.6f * y2; if (++rvP2 >= RV_AP2) rvP2 = 0;
    float a0 = rvA[rvPa], a1 = rvB[rvPb], a2 = rvC[rvPc], a3 = rvD[rvPd];
    rvLp[0] += rvK * (a0 - rvLp[0]); rvLp[1] += rvK * (a1 - rvLp[1]);
    rvLp[2] += rvK * (a2 - rvLp[2]); rvLp[3] += rvK * (a3 - rvLp[3]);
    float h0 = 0.5f * (rvLp[0] + rvLp[1] + rvLp[2] + rvLp[3]), h1 = 0.5f * (rvLp[0] - rvLp[1] + rvLp[2] - rvLp[3]);
    float h2 = 0.5f * (rvLp[0] + rvLp[1] - rvLp[2] - rvLp[3]), h3 = 0.5f * (rvLp[0] - rvLp[1] - rvLp[2] + rvLp[3]);
    rvA[rvPa] = y2 + h0 * rvG[0]; if (++rvPa >= RV_A) rvPa = 0;
    rvB[rvPb] = -y2 + h1 * rvG[1]; if (++rvPb >= RV_B) rvPb = 0;
    rvC[rvPc] = y2 + h2 * rvG[2]; if (++rvPc >= RV_C) rvPc = 0;
    rvD[rvPd] = -y2 + h3 * rvG[3]; if (++rvPd >= RV_D) rvPd = 0;
    float revL = rvLp[0] - 0.7f * rvLp[2] + 0.3f * rvLp[1], revR = rvLp[1] - 0.7f * rvLp[3] + 0.3f * rvLp[2];

    l += revL * REV_GAN + dl * ECO_GAN;
    r += revR * REV_GAN + dr * ECO_GAN;

    // DC → volumen → limitador con lookahead → 13 kHz (después del limitador: multiplicar es modular)
    float yl = l - dcXL + 0.9995f * dcYL; dcXL = l; dcYL = yl;
    float yr = r - dcXR + 0.9995f * dcYR; dcXR = r; dcYR = yr;
    volS += (volObj - volS) * 0.002f;
    l = yl * volS; r = yr * volS;
    float pk = fabsf(l) > fabsf(r) ? fabsf(l) : fabsf(r);
    if (pk > limEnv) limEnv = pk; else limEnv = pk + (limEnv - pk) * limRel;
    float limObj = (limEnv > TECHO) ? (TECHO / limEnv) : 1.0f;
    limGain += (limObj - limGain) * 0.020f;
    float ll = limDlyL[limDlyIdx], lr = limDlyR[limDlyIdx];
    limDlyL[limDlyIdx] = l; limDlyR[limDlyIdx] = r;
    if (++limDlyIdx >= LIM_LOOK) limDlyIdx = 0;
    l = pasoBQ(techoL, techoSuave(ll * limGain));
    r = pasoBQ(techoR, techoSuave(lr * limGain));
    int32_t li = (int32_t)(l * 32000.0f), ri = (int32_t)(r * 32000.0f);
    salida[2 * i]     = (int16_t)(li > 32767 ? 32767 : li < -32768 ? -32768 : li);
    salida[2 * i + 1] = (int16_t)(ri > 32767 ? 32767 : ri < -32768 ? -32768 : ri);
  }
}

void iniciarAudio() {
  for (int i = 0; i <= TABLA; i++) SENO[i] = sinf(2.0f * PI_F * i / TABLA);
  // ondas del pad, limitadas en banda para la nota más aguda que tocan (E6 en CRISTAL):
  //   0 coro:    armónicos 1..10 que caen rápido (1/n^1.7), los pares más bajos → un "aah" suave
  //   1 cuerdas: armónicos 1..14 que caen lento (1/n^1.1) → más cuerpo y brillo
  //   2 vidrio:  sólo octavas (1, 2, 4, 8) → brilla sin ensuciar
  for (int w = 0; w < NUM_ONDAS_PAD; w++) {
    float pico = 0.0f;
    for (int i = 0; i <= TABLA_PAD; i++) {
      float x = 0.0f, fase = 2.0f * PI_F * i / TABLA_PAD;
      if (w == 0)      for (int h = 1; h <= 10; h++) x += sinf(fase * h) * powf((float)h, -1.7f) * ((h & 1) ? 1.0f : 0.7f);
      else if (w == 1) for (int h = 1; h <= 14; h++) x += sinf(fase * h) * powf((float)h, -1.1f);
      else { const float A[4] = { 1.0f, 0.5f, 0.3f, 0.15f }; for (int k = 0; k < 4; k++) x += sinf(fase * (1 << k)) * A[k]; }
      ONDA_PAD[w][i] = x; if (fabsf(x) > pico) pico = fabsf(x);
    }
    for (int i = 0; i <= TABLA_PAD; i++) ONDA_PAD[w][i] /= pico;
  }
  kPadAtk = coefUnPolo(1.4f);  kPadRel = coefUnPolo(2.2f); kPadFin = coefUnPolo(0.06f);
  kPadAtkRapido = coefUnPolo(0.30f); kPadRelEscena = coefUnPolo(0.45f);
  kBajoAtk = coefUnPolo(0.12f); kBajoRel = coefUnPolo(0.50f);
  kAveAtk = coefUnPolo(0.003f); kAveRel = coefUnPolo(0.008f);
  kMeloAtk = coefUnPolo(0.045f); kMeloRel = coefUnPolo(0.14f);
  kRafUp = 1.0f - expf(-DT_BLOQUE / 0.35f); kRafDown = 1.0f - expf(-DT_BLOQUE / 1.6f);
  coefFiltro(padFL, padCorteS, 0.6f); padFL.ic1 = padFL.ic2 = 0.0f; padFR = padFL;
  memset(vBP, 0, sizeof(vBP));
  for (int b = 0; b < 3; b++) { bqBPF(vBP[0][b], V_FC[b], V_Q[b]); bqBPF(vBP[1][b], V_FC[b] * 1.07f, V_Q[b]); }
  memset(&techoL, 0, sizeof(techoL)); bqLPF(techoL, 13000.0f, 0.7071f); techoR = techoL;
  const int RL[4] = { RV_A, RV_B, RV_C, RV_D };
  for (int k = 0; k < 4; k++) rvG[k] = powf(10.0f, -3.0f * RL[k] / (SR * REVERB_T60));
  rvK = 1.0f - expf(-2.0f * PI_F * REVERB_CORTE / SR);
  limRel = expf(-1.0f / (SR * 0.08f));
  memset(pads, 0, sizeof(pads)); memset(bajos, 0, sizeof(bajos)); memset(campanas, 0, sizeof(campanas));
  memset(arpas, 0, sizeof(arpas)); memset(aves, 0, sizeof(aves)); memset(percs, 0, sizeof(percs));
  memset(gotas, 0, sizeof(gotas)); memset(burbujas, 0, sizeof(burbujas));
  memset(&tambor, 0, sizeof(tambor));
  memset(vocesMuestra, 0, sizeof(vocesMuestra)); memset(saliendo, 0, sizeof(saliendo));
  aves[AVE_CERCA].especie = -1;
  for (int c = 0; c < NUM_CAPAS; c++) lvl[c] = 0.0f;
  balS = potBal; densS = potDens;
#ifdef CONTINUA_LARGO
  iniciarLector(lecL); iniciarLector(lecR);
#endif
  nuevaEscena();
  padCorteS = PALETAS[paleta].cortePad;
  acordeActual = PROGRESIONES[prog][0];
}

// ==============================================================================================================================================
// I2S Y TAREA DE AUDIO (core 1)
// ==============================================================================================================================================
i2s_chan_handle_t tx_chan;

void i2s_init() {
  i2s_chan_config_t chan_cfg = I2S_CHANNEL_DEFAULT_CONFIG(I2S_NUM_0, I2S_ROLE_MASTER);
  chan_cfg.auto_clear    = true;
  chan_cfg.dma_desc_num  = 4;
  chan_cfg.dma_frame_num = BUFFER_SAMPLES;
  ESP_ERROR_CHECK(i2s_new_channel(&chan_cfg, &tx_chan, NULL));
  i2s_std_config_t std_cfg = {
    .clk_cfg  = I2S_STD_CLK_DEFAULT_CONFIG(SAMPLE_RATE),
    .slot_cfg = I2S_STD_PHILIPS_SLOT_DEFAULT_CONFIG(I2S_DATA_BIT_WIDTH_16BIT, I2S_SLOT_MODE_STEREO),
    .gpio_cfg = {
      .mclk = I2S_GPIO_UNUSED,
      .bclk = (gpio_num_t)I2S_BCK,
      .ws   = (gpio_num_t)I2S_LCK,
      .dout = (gpio_num_t)I2S_DIN,
      .din  = I2S_GPIO_UNUSED,
      .invert_flags = { false, false, false },
    },
  };
  ESP_ERROR_CHECK(i2s_channel_init_std_mode(tx_chan, &std_cfg));
  ESP_ERROR_CHECK(i2s_channel_enable(tx_chan));
}

void audioTask(void *) {
  static int16_t salida[BUFFER_SAMPLES * 2];
  const float ciclosBloque = 240e6f * BUFFER_SAMPLES / SR;
  size_t n;
  for (;;) {
    uint32_t c0 = ESP.getCycleCount();
    procesarBloque(salida);
    float uso = (ESP.getCycleCount() - c0) / ciclosBloque;
    cpuPub = uso > cpuPub ? uso : cpuPub * 0.995f;   // el peor caso reciente, para el LED 5
    i2s_channel_write(tx_chan, salida, sizeof(salida), &n, portMAX_DELAY);
  }
}

// ==============================================================================================================================================
// CONTROL (core 0, 1 kHz): botones, perillas, LEDs y Serial
// ==============================================================================================================================================
CRGB leds[NUM_LEDS];
bool btnAbajo[5] = { false, false, false, false, false };
unsigned long btnCambio[5] = { 0, 0, 0, 0, 0 };
unsigned long destello[4] = { 0, 0, 0, 0 };          // escena · ave · ráfaga · muestra
uint32_t escenaVista = 0;
int      potScan = 0;

float leerPot(uint8_t pin) { uint32_t s = 0; for (int i = 0; i < 4; i++) s += analogRead(pin); return (s >> 2) / 4095.0f; }

void pasoBotones(unsigned long t) {
  for (int b = 0; b < 5; b++) {
    bool abajo = digitalRead(BTN_PIN[b]) == LOW;
    if (abajo == btnAbajo[b] || t - btnCambio[b] < 25) continue;   // antirrebote
    btnCambio[b] = t; btnAbajo[b] = abajo;
    if (!abajo) continue;
    entropia = micros();                         // el instante exacto del toque es el mejor azar de la placa
    switch (b) {                                 // todo en el flanco de bajada: suena en el acto
      case 0: pedPlay = pedPlay + 1; break;
      case 1: pedEscena = pedEscena + 1; destello[0] = t ? t : 1; break;
      case 2: pedAve = pedAve + 1; destello[1] = t ? t : 1; break;
      case 3: pedRafaga = pedRafaga + 1; destello[2] = t ? t : 1; break;
      case 4: pedMuestra = pedMuestra + 1; destello[3] = t ? t : 1; break;
    }
  }
}

void aplicarPerilla(int i) {
  float v = leerPot(POT_PIN[i]);
  switch (i) {
    case 0: { float obj = v < 0.01f ? 0.0f : powf(v, CURVA_VOLUMEN); potVol = obj; } break;
    case 1: if (fabsf(v - potBal)  > 0.006f) potBal = v;  break;      // banda muerta: el ruido del ADC no mueve nada
    case 2: if (fabsf(v - potDens) > 0.006f) potDens = v; break;
    case 3: if (fabsf(v - potVert) > 0.006f) potVert = v; break;
  }
}

static inline CRGB escalar(CRGB c, float a) { uint8_t s = (uint8_t)(255.0f * clamp01(a)); return c.nscale8(s); }

// ─── Tira atmosférica (core 0, 50 cuadros/s) ─────────────────
// Siete efectos lentos que no siguen a la música: sólo ambientan. Cada uno es una función del tiempo y de la
// posición (nada de pasos al azar por cuadro), así que se mueven sin saltos. Cada 45–80 s se pasa a otro, nunca el
// mismo, con un fundido de 8 s en el que se ven los dos.
#define NUM_EFECTOS 7
const char *const NOMBRE_EFECTO[NUM_EFECTOS] = { "aurora", "atardecer", "olas", "luciernagas", "claros del bosque", "luna", "nubes" };
#define NUM_LUCIERNAGAS 8
float tiraA[TIRA_LEDS * 3], tiraB[TIRA_LEDS * 3], tiraErr[TIRA_LEDS * 3];   // efecto actual · el que entra · resto del dithering
int   efActual = 0, efSiguiente = -1;
float efCruce = 0.0f, efQueda = 60.0f, tiraNivel = 0.0f, tiraLimite = 1.0f;
float lucX[NUM_LUCIERNAGAS], lucFase[NUM_LUCIERNAGAS], lucVel[NUM_LUCIERNAGAS], lucDeriva[NUM_LUCIERNAGAS];
uint32_t rngLuz = 0x2545F491u;                       // azar propio del core 0 (el de composición es del audio)
static inline float azarLuz() { rngLuz ^= rngLuz << 13; rngLuz ^= rngLuz >> 17; rngLuz ^= rngLuz << 5; return (rngLuz >> 8) * (1.0f / 16777216.0f); }
static inline float ondaLuz(float x) { float f = x - floorf(x); if (f >= 1.0f) f = 0.0f; return seno(f); }   // sin(2πx)
static inline float suaveLuz(float a, float b, float x) { float u = clamp01((x - a) / (b - a)); return u * u * (3.0f - 2.0f * u); }
static inline void ponerLuz(float *o, int i, float r, float g, float b) { o[3 * i] = r; o[3 * i + 1] = g; o[3 * i + 2] = b; }

void nuevaLuciernaga(int k) {
  lucX[k] = azarLuz() * (TIRA_LEDS - 1); lucFase[k] = 0.0f;
  lucVel[k] = 1.0f / (4.0f + 5.0f * azarLuz());      // un ciclo de encender y apagar cada 4–9 s
  lucDeriva[k] = (azarLuz() - 0.5f) * 0.8f;          // se mueve un poco mientras brilla (LEDs/s)
}

void efectoLuz(int e, float t, float dt, float *o) {
  for (int i = 0; i < TIRA_LEDS; i++) {
    const float x = (float)i / (TIRA_LEDS - 1);
    switch (e) {
      case 0: {   // AURORA: cortinas verde-agua y violeta que ondulan sobre un azul noche
        float a = (0.5f + 0.5f * ondaLuz(x * 1.3f + t / 37.0f)) * (0.5f + 0.5f * ondaLuz(x * 0.7f - t / 53.0f + 0.3f));
        a *= a;
        float m = 0.5f + 0.5f * ondaLuz(x * 0.5f + t / 71.0f);
        ponerLuz(o, i, 0.04f + a * (0.10f + 0.40f * m), 0.08f + a * (0.75f - 0.55f * m), 0.18f + a * (0.45f + 0.20f * m));
      } break;
      case 1: {   // ATARDECER: un degradé rosa-ámbar que respira y se corre despacio
        float g = 0.5f + 0.5f * ondaLuz(x * 0.8f + t / 45.0f);
        float k = (0.75f + 0.25f * ondaLuz(t / 19.0f)) * (0.6f + 0.4f * (0.5f + 0.5f * ondaLuz(x * 1.7f - t / 29.0f)));
        ponerLuz(o, i, (0.60f + 0.35f * g) * k, (0.12f + 0.35f * g) * k, (0.20f - 0.12f * g) * k);
      } break;
      case 2: {   // OLAS: dos olas de espuma que ruedan en sentidos contrarios sobre un azul profundo
        float w1 = ondaLuz(x * 1.6f - t / 11.0f); w1 = w1 > 0 ? w1 * w1 * w1 : 0.0f;
        float w2 = ondaLuz(x * 2.3f + t / 17.0f + 0.4f); w2 = w2 > 0 ? w2 * w2 * w2 : 0.0f;
        float w = 0.65f * w1 + 0.40f * w2;
        ponerLuz(o, i, 0.03f + 0.35f * w, 0.14f + 0.55f * w, 0.32f + 0.45f * w);
      } break;
      case 3:     // LUCIÉRNAGAS: noche verde muy tenue (las luces se suman abajo)
        ponerLuz(o, i, 0.02f, 0.09f, 0.05f);
        break;
      case 4: {   // CLAROS DEL BOSQUE: manchas de sol que se pasean sobre el verde
        float n = 0.5f + (ondaLuz(x * 1.1f + t / 41.0f) + 0.6f * ondaLuz(x * 2.7f - t / 27.0f + 0.2f) + 0.35f * ondaLuz(x * 4.3f + t / 63.0f + 0.7f)) / 3.9f;
        float s = suaveLuz(0.55f, 0.85f, n);
        ponerLuz(o, i, 0.08f + 0.80f * s, 0.30f + 0.45f * s, 0.06f + 0.14f * s);
      } break;
      case 5: {   // LUNA: luz fría que respira, con un claro plateado que viaja de un extremo al otro
        float c = 0.5f + 0.42f * ondaLuz(t / 61.0f), d = (x - c) / 0.18f;
        float spot = expf(-d * d), k = 0.65f + 0.25f * ondaLuz(t / 23.0f);
        ponerLuz(o, i, 0.16f * k + 0.40f * spot, 0.22f * k + 0.45f * spot, 0.42f * k + 0.50f * spot);
      } break;
      default: {  // NUBES: nubes crema que pasan sobre el cielo
        float n = 0.5f + (ondaLuz(x * 0.9f - t / 33.0f) + 0.7f * ondaLuz(x * 2.1f - t / 21.0f + 0.5f) + 0.3f * ondaLuz(x * 3.7f - t / 47.0f)) / 4.0f;
        float s = suaveLuz(0.48f, 0.80f, n);
        ponerLuz(o, i, 0.14f + 0.62f * s, 0.26f + 0.48f * s, 0.55f + 0.17f * s);
      } break;
    }
  }
  if (e == 3) {                                      // las luciérnagas: cada una se enciende y se apaga despacio
    for (int k = 0; k < NUM_LUCIERNAGAS; k++) {
      lucFase[k] += dt * lucVel[k];
      if (lucFase[k] >= 1.0f) nuevaLuciernaga(k);    // renace en otro lugar cuando ya está apagada
      float s = ondaLuz(lucFase[k] * 0.5f);          // medio seno: sube y baja una vez por ciclo
      float b = s * s * s * s;
      lucX[k] += lucDeriva[k] * dt;
      for (int i = (int)lucX[k] - 2; i <= (int)lucX[k] + 3; i++) {
        if (i < 0 || i >= TIRA_LEDS) continue;
        float d = (i - lucX[k]) / 1.1f, g = b * expf(-d * d);
        o[3 * i] += 0.75f * g; o[3 * i + 1] += 0.90f * g; o[3 * i + 2] += 0.12f * g;
      }
    }
  }
}

void renderTira(float t, float dt, bool toc) {
  // el turno de los efectos
  if (efSiguiente < 0) {
    efQueda -= dt;
    if (efQueda <= 0.0f) {
      int e = (int)(azarLuz() * NUM_EFECTOS); if (e >= NUM_EFECTOS) e = NUM_EFECTOS - 1;
      if (e == efActual) e = (e + 1 + (int)(azarLuz() * (NUM_EFECTOS - 1))) % NUM_EFECTOS;
      efSiguiente = e; efCruce = 0.0f;
    }
  }
  efectoLuz(efActual, t, dt, tiraA);
  float mezcla = 0.0f;
  if (efSiguiente >= 0) {
    efectoLuz(efSiguiente, t, dt, tiraB);
    efCruce += dt / CRUCE_S;
    mezcla = suaveLuz(0.0f, 1.0f, efCruce);
    if (efCruce >= 1.0f) {
      efActual = efSiguiente; efSiguiente = -1; mezcla = 0.0f;
      memcpy(tiraA, tiraB, sizeof(tiraA));
      efQueda = EFECTO_MIN_S + (EFECTO_MAX_S - EFECTO_MIN_S) * azarLuz();
#if MOSTRAR_ESTADO
      if (toc) LOG("Luces: %s\n", NOMBRE_EFECTO[efActual]);
#endif
    }
  }
  // entra con Play y se va con Stop
  const float kNivel = 1.0f - expf(-dt / (TIRA_ENTRA_S / 3.0f));
  tiraNivel += ((toc ? 1.0f : 0.0f) - tiraNivel) * kNivel;
  // a lineal (gamma 2.2) y limitador de corriente: ataca en el acto, se recupera lento (un salto hacia arriba es lo que
  // hunde los 5 V)
  static float lin[TIRA_LEDS * 3];
  float sumaMa = 0.0f;
  for (int j = 0; j < TIRA_LEDS * 3; j++) {
    float v = tiraA[j] + (tiraB[j] - tiraA[j]) * mezcla;
    v = clamp01(v) * TIRA_BRILLO * tiraNivel;
    v = powf(v, 2.2f);
    lin[j] = v; sumaMa += v * 20.0f;                 // ~20 mA por canal encendido al 100 %
  }
  float limObj = sumaMa > TIRA_MAX_MA ? TIRA_MAX_MA / sumaMa : 1.0f;
  if (limObj < tiraLimite) tiraLimite = limObj; else tiraLimite += (limObj - tiraLimite) * 0.02f;
  // a 8 bit con dithering temporal (se arrastra el resto de cada cuadro): los fundidos lentos no se ven a saltos
  for (int i = 0; i < TIRA_LEDS; i++) {
    uint8_t c[3];
    for (int k = 0; k < 3; k++) {
      int j = 3 * i + k;
      float v = lin[j] * tiraLimite * 255.0f + tiraErr[j];
      int q = (int)(v + 0.5f); if (q < 0) q = 0; if (q > 255) q = 255;
      tiraErr[j] = v - q;
      if (tiraErr[j] > 1.0f) tiraErr[j] = 1.0f; else if (tiraErr[j] < -1.0f) tiraErr[j] = -1.0f;
      c[k] = (uint8_t)q;
    }
    leds[LEDS_PLACA + i] = CRGB(c[0], c[1], c[2]);
  }
}

void renderLEDs(unsigned long t) {
  static uint32_t pulsoVisto = 0;
  static float pulso = 0.0f;
  if (pulsoPub != pulsoVisto) { pulsoVisto = pulsoPub; pulso = 1.0f; }
  pulso *= 0.82f;
  const CRGB COL[5] = { CRGB(30, 120, 20), CRGB(0, 110, 80), CRGB(30, 80, 170), CRGB(190, 120, 10), CRGB(210, 180, 130) };
  const bool toc = tocandoPub;
  const float d = potDens;
  for (int i = 0; i < 5; i++) {
    float x = clamp01((d - i * 0.2f) / 0.2f);
    leds[i] = escalar(COL[i], toc ? x * (0.25f + 0.75f * x) : 0.08f * x);
  }
  leds[5] = toc ? CRGB(0, (uint8_t)(18 + 160 * pulso), (uint8_t)(8 + 60 * pulso)) : CRGB(12, 12, 10);
  const CRGB FL[4] = { CRGB(200, 200, 190), CRGB(60, 150, 255), CRGB(255, 170, 20), CRGB(0, 200, 160) };
  for (int k = 0; k < 4; k++) {
    if (!destello[k] || t - destello[k] > 350) continue;
    float a = 1.0f - (t - destello[k]) / 350.0f;
    for (int i = 0; i < LEDS_PLACA; i++) {           // los destellos son sólo de la placa: la tira no reacciona
      CRGB c = escalar(FL[k], a);
      if (c.r > leds[i].r) leds[i].r = c.r;
      if (c.g > leds[i].g) leds[i].g = c.g;
      if (c.b > leds[i].b) leds[i].b = c.b;
    }
  }
  if (cpuPub > 0.8f) leds[5] = CRGB(160, 0, 140);
  for (int i = 0; i < LEDS_PLACA; i++) leds[i].nscale8(LED_BRILLO);   // la placa con su brillo; la tira lleva el suyo
  static unsigned long tAnt = 0;
  float dt = tAnt ? (t - tAnt) * 0.001f : 0.02f; tAnt = t;
  if (dt > 0.1f) dt = 0.1f;
  renderTira(t * 0.001f, dt, toc);
  FastLED.show();
}

void imprimirEscena() {
#if MOSTRAR_ESTADO
  const int *p = PROGRESIONES[progPub];
  const Paleta &P = PALETAS[paletaPub];
  LOG("Escena %u: %s — pad %s · melodía %s · arpegio %s · arriba %s\n", (unsigned)escenaPub, P.nombre,
      NOMBRE_ONDA[P.onda], MELODIAS[P.melo].nombre, P.arpa < 0 ? "arpa" : TIMBRES[P.arpa].nombre, TIMBRES[P.kal].nombre);
  LOG("          %s · %s · %s · %s | %d BPM | figura: %s | aves: %s + %s\n",
      ACORDES[p[0]].nombre, ACORDES[p[1]].nombre, ACORDES[p[2]].nombre, ACORDES[p[3]].nombre,
      bpmPub, NOMBRE_FIGURA[figuraPub], NOMBRE_ESPECIE[especiePub0], NOMBRE_ESPECIE[especiePub1]);
#endif
}

void pasoControl(unsigned long t) {
  static unsigned long ultLED = 0;
  static int muestraVista = -1;
  pasoBotones(t);
  aplicarPerilla(potScan); potScan = (potScan + 1) & 3;      // una perilla por pasada
  if (escenaPub != escenaVista) { escenaVista = escenaPub; imprimirEscena(); }
#if MOSTRAR_ESTADO
  static unsigned long ultCPU = 0; static float cpuMax = 0.0f;
  if (cpuPub > cpuMax) cpuMax = cpuPub;
  if (t - ultCPU >= 10000) { ultCPU = t; if (tocandoPub) LOG("CPU del audio: pico %d %% del tiempo de un bloque\n", (int)(cpuMax * 100.0f + 0.5f)); cpuMax = 0.0f; }
#endif
#if NUM_MUESTRAS > 0 && MOSTRAR_ESTADO
  if (muestraPub != muestraVista && muestraPub >= 0) { muestraVista = muestraPub; LOG("Sonido natural: %s\n", MUESTRA_NOMBRE[muestraVista]); }
#else
  (void)muestraVista;
#endif
  if (t - ultLED >= 20) { ultLED = t; renderLEDs(t); }
}

void controlTask(void *) {
  // FastLED se inicia acá (core 0): las interrupciones del RMT quedan en el core que lo inicia, lejos del audio
  FastLED.addLeds<WS2812, LED_PIN, GRB>(leds, NUM_LEDS);
  FastLED.setBrightness(255);                      // cada parte escala su brillo (la placa con LED_BRILLO, la tira con TIRA_BRILLO)
  FastLED.clear(); FastLED.show();
  rngLuz ^= micros(); if (!rngLuz) rngLuz = 1u;    // cada encendido parte con otro efecto
  for (int k = 0; k < NUM_LUCIERNAGAS; k++) { nuevaLuciernaga(k); lucFase[k] = azarLuz(); }
  efActual = (int)(azarLuz() * NUM_EFECTOS) % NUM_EFECTOS;
  for (;;) { pasoControl(millis()); vTaskDelay(1); }
}

