  for (;;) {
    if (!lista) {
      if (oledPresente() && oledIniciar()) { lista = true; contraste = OLED_CONTRASTE_DESPIERTA; LOG("Pantalla OLED: el ave está posada\n"); }
      else { vTaskDelay(3000 / portTICK_PERIOD_MS); continue; }
    }
    const unsigned long t = millis();
    float dt = (t - tAnt) * 0.001f; tAnt = t; if (dt > 0.1f) dt = 0.1f;

    // ─ estado del ave ─
    if (aveCantaPub) ultCanta = t ? t : 1;
    const bool canta  = ultCanta && t - ultCanta < 90;        // los trinos (notas de 30 ms) dejan el pico abierto, sin parpadear
    const bool cantoReciente = ultCanta && t - ultCanta < 1500;
    const bool duerme = !tocandoPub && !cantoReciente;
    const uint32_t nv = aveNotaPub;
    if (nv != notaVista) {
      notaVista = nv;
      if (t - ultNota > 230) {                                 // un trino no suelta una nube: a lo más ~4 notas por segundo
        ultNota = t;
        soltarNota(azarPant() < 0.65f ? G_CORCHEA : G_DOBLE, 25.0f, 14.0f,
                   -(11.0f + 8.0f * azarPant()), -(4.0f + 4.0f * azarPant()), 1.9f);
      }
    }
    if (duerme && t - ultZ > 1400) {                           // durmiendo: unas z que suben desde la cabeza
      ultZ = t;
      soltarNota(azarPant() < 0.5f ? G_ZCHICA : G_ZGRANDE, 56.0f, 11.0f, 5.0f + 2.0f * azarPant(), -(4.0f + 1.5f * azarPant()), 2.4f);
    }
    if (!duerme && !canta && t >= proxParpadeo) {
      parpadeoHasta = t + 140;
      proxParpadeo = t + 2500 + (unsigned long)(azarPant() * 4500.0f);
    }
    const int cuadro = canta ? AVE_CANTA : (duerme || t < parpadeoHasta) ? AVE_PARPADEO : AVE_REPOSO;

    // ─ armar el cuadro ─
    memcpy(pantalla, AVE[cuadro], 1024);
    for (int i = 0; i < NUM_NOTAS_VUELAN; i++) {
      NotaVuela &n = notasVuelan[i];
      if (!n.viva) continue;
      n.t += dt;
      const bool esZ = n.glifo >= G_ZCHICA;
      if (n.t >= n.vida || (esZ && !duerme)) { n.viva = false; continue; }   // al despertar, las z se van
      n.x += n.vx * dt; n.y += n.vy * dt;
      const float vaiven = (esZ ? 1.0f : 1.6f) * sinf(n.fase + n.t * 5.0f);
      glifoPant(n.glifo, (int)lroundf(n.x), (int)lroundf(n.y + vaiven));
    }

    // ─ mandarlo ─
    const uint8_t c = duerme ? OLED_CONTRASTE_DUERME : OLED_CONTRASTE_DESPIERTA;
    bool ok = true;
    if (c != contraste) { const uint8_t cmd[2] = { 0x81, c }; ok = oledComandos(cmd, 2); if (ok) contraste = c; }
    if (ok) ok = oledCuadro();
    if (!ok) { lista = false; continue; }                      // se desconectó: vuelve a buscarla
    vTaskDelay(33 / portTICK_PERIOD_MS);                       // ~20 cuadros por segundo con lo que tarda el I2C
  }
}

