// Todo se escribe en GRADOS de la escala hexatónica (6 por octava). Grado 0 = E2; 6 = E3; 12 = E4; 18 = E5; 24 = E6.
const int ESCALA[6] = { 0, 2, 4, 5, 7, 11 };                 // E F# G# A B D#
static inline int mod6(int g)      { int r = g % 6; return r < 0 ? r + 6 : r; }
static inline int gradoMidi(int g) { return 40 + 12 * ((g - mod6(g)) / 6) + ESCALA[mod6(g)]; }
static inline int pcGrado(int g)   { return ESCALA[mod6(g)]; }

