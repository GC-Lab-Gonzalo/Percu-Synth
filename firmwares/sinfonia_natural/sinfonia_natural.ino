    0xDA, 0x12, 0x81, OLED_CONTRASTE_DESPIERTA, 0xD9, 0xF1, 0xDB, 0x40, 0xA4, 0xA6, 0x2E, 0xAF
  };
  return oledComandos(init, sizeof(init));
}
bool oledCuadro() {
  const uint8_t ventana[] = { 0x21, 0, 127, 0x22, 0, 7 };
  if (!oledComandos(ventana, sizeof(ventana))) return false;
  for (int i = 0; i < 1024; i += 64) {                         // el buffer de Wire es de 128: trozos de 64
    Wire.beginTransmission(OLED_DIR);
    Wire.write((uint8_t)0x40);                                 // D/C = 1: datos
    Wire.write(pantalla + i, 64);
    if (Wire.endTransmission() != 0) return false;
  }
  return true;
}
bool oledPresente() { Wire.beginTransmission(OLED_DIR); return Wire.endTransmission() == 0; }

