// ==============================================================================================================================================
// DSP — utilidades (sin libm por muestra)
// ==============================================================================================================================================
float SENO[TABLA + 1];
float ONDA_PAD[NUM_ONDAS_PAD][TABLA_PAD + 1];
static inline float seno(float f)    { float x = f * TABLA;     int i = (int)x; float r = x - i; return SENO[i] + (SENO[i + 1] - SENO[i]) * r; }
static inline float ondaPad(const float *t, float f) { float x = f * TABLA_PAD; int i = (int)x; float r = x - i; return t[i] + (t[i + 1] - t[i]) * r; }
static inline float frac1(float x)   { return x - (int)x; }
uint32_t semRuidoL = 12345u, semRuidoR = 67891u, semExc = 424242u;
static inline float ruido(uint32_t &s) { s = s * 1664525u + 1013904223u; return (int32_t)s * (1.0f / 2147483648.0f); }
static inline float tanRapido(float x) { float x2 = x * x; return x * (15.0f - x2) / (15.0f - 6.0f * x2); }
static inline float decaimiento(float tau) { return expf(-1.0f / (tau * SR)); }
static inline float coefUnPolo(float tau)  { return 1.0f - expf(-1.0f / (tau * SR)); }
static inline float hzMidi(float m) { return 440.0f * exp2f((m - 69.0f) / 12.0f); }
static inline float hzGrado(int g)  { return hzMidi((float)gradoMidi(g)); }
static inline float clamp01(float x) { return x < 0.0f ? 0.0f : (x > 1.0f ? 1.0f : x); }
static inline void panear(float p, float &gL, float &gR) { float a = (p + 1.0f) * 0.25f * PI_F; gL = cosf(a); gR = sinf(a); }
void coefFiltro(Filtro &s, float fc, float q) {
  float g = tanRapido(PI_F * fc / SR); s.k = 1.0f / q;
  s.a1 = 1.0f / (1.0f + g * (g + s.k)); s.a2 = g * s.a1; s.a3 = g * s.a2;
}
// DITHER: un filtro que se queda sin entrada decae hacia cero y a medio camino sus estados caen en SUBNORMALES, donde
// cada multiplicación cuesta ~100 veces más (lección de triphop_viaje). 1e-18 es un float normal y en la salida es −360 dB.
// La defensa vive DENTRO de las primitivas para que ningún filtro nuevo quede sin ella.
#define DITHER 1e-18f
static inline float pasoLP(Filtro &s, float x) {
  x += DITHER;
  float v3 = x - s.ic2, v1 = s.a1 * s.ic1 + s.a2 * v3, v2 = s.ic2 + s.a2 * s.ic1 + s.a3 * v3;
  s.ic1 = 2.0f * v1 - s.ic1; s.ic2 = 2.0f * v2 - s.ic2;
  return v2;
}
static inline float pasoBQ(BQ &q, float x) { x += DITHER; float y = q.b0 * x + q.z1; q.z1 = q.b1 * x - q.a1 * y + q.z2; q.z2 = q.b2 * x - q.a2 * y; return y; }
void bqBPF(BQ &c, float fc, float Q) {           // pico 0 dB; conserva el estado (se puede llamar en marcha)
  float w = 2.0f * PI_F * fc / SR, s = sinf(w), co = cosf(w), al = s / (2.0f * Q), a0 = 1.0f + al;
  c.b0 = al / a0; c.b1 = 0.0f; c.b2 = -al / a0; c.a1 = -2.0f * co / a0; c.a2 = (1.0f - al) / a0;
}
void bqLPF(BQ &c, float fc, float Q) {
  float w = 2.0f * PI_F * fc / SR, s = sinf(w), co = cosf(w), al = s / (2.0f * Q), a0 = 1.0f + al;
  c.b0 = (1.0f - co) * 0.5f / a0; c.b1 = (1.0f - co) / a0; c.b2 = c.b0; c.a1 = -2.0f * co / a0; c.a2 = (1.0f - al) / a0;
}
static inline float techoSuave(float x) {
  float a = fabsf(x); if (a <= 0.95f) return x;
  float y = 0.95f + 0.05f * tanhf((a - 0.95f) / 0.05f); return x < 0 ? -y : y;
}

// IMA ADPCM: los sonidos grabados van comprimidos a 4 bits (4 veces menos flash que 16 bit). Bloques de 1024 muestras,
// cada uno con su cabecera (predictor + índice), así se puede empezar a leer en cualquier bloque. Las mismas tablas
// usa preparar_muestras.py para comprimir.
#define ADPCM_BLOQUE 1024
#define ADPCM_BYTES  (3 + ADPCM_BLOQUE / 2)
const int16_t PASO_IMA[89] = {
  7, 8, 9, 10, 11, 12, 13, 14, 16, 17, 19, 21, 23, 25, 28, 31, 34, 37, 41, 45, 50, 55, 60, 66, 73, 80, 88, 97, 107,
  118, 130, 143, 157, 173, 190, 209, 230, 253, 279, 307, 337, 371, 408, 449, 494, 544, 598, 658, 724, 796, 876,
  963, 1060, 1166, 1282, 1411, 1552, 1707, 1878, 2066, 2272, 2499, 2749, 3024, 3327, 3660, 4026, 4428, 4871, 5358,
  5894, 6484, 7132, 7845, 8630, 9493, 10442, 11487, 12635, 13899, 15289, 16818, 18500, 20350, 22385, 24623,
  27086, 29794, 32767 };
const int8_t INDICE_IMA[16] = { -1, -1, -1, -1, 2, 4, 6, 8, -1, -1, -1, -1, 2, 4, 6, 8 };
void adpcmIniciar(Adpcm &d, const uint8_t *datos, uint32_t bloque) { d.p = datos + bloque * ADPCM_BYTES; d.n = 0; d.pred = 0; d.idx = 0; }
static inline int adpcmSig(Adpcm &d) {
  if ((d.n & (ADPCM_BLOQUE - 1)) == 0) {           // bloque nuevo: el estado viene en su cabecera
    d.pred = (int16_t)(d.p[0] | (d.p[1] << 8)); d.idx = d.p[2]; d.p += 3;
  }
  int c = (d.n & 1) ? (*d.p++ >> 4) : (*d.p & 15);
  int paso = PASO_IMA[d.idx], dif = paso >> 3;
  if (c & 4) dif += paso;
  if (c & 2) dif += paso >> 1;
  if (c & 1) dif += paso >> 2;
  d.pred += (c & 8) ? -dif : dif;
  if (d.pred > 32767) d.pred = 32767; else if (d.pred < -32768) d.pred = -32768;
  d.idx += INDICE_IMA[c]; if (d.idx < 0) d.idx = 0; else if (d.idx > 88) d.idx = 88;
  d.n++;
  return d.pred;
}

// Composición: un generador aparte del ruido de audio; cada botón le mezcla el instante exacto en que se apretó
uint32_t rngComp = 0x9E3779B9u;
static inline float frnd() { rngComp ^= rngComp << 13; rngComp ^= rngComp >> 17; rngComp ^= rngComp << 5; return (rngComp >> 8) * (1.0f / 16777216.0f); }
static inline float entre(float a, float b) { return a + (b - a) * frnd(); }
static inline int azar(int n) { int k = (int)(frnd() * n); return k >= n ? n - 1 : k; }
void mezclarSemilla(uint32_t s) { rngComp ^= s * 2654435761u; if (!rngComp) rngComp = 1; for (int i = 0; i < 4; i++) frnd(); }

// Grados que son notas del acorde
static inline bool esTono(int g, uint16_t tonos) { return tonos & (1u << pcGrado(g)); }
int ajustarATono(int g, uint16_t tonos) {
  if (esTono(g, tonos)) return g;
  for (int k = 1; k < 4; k++) { if (esTono(g - k, tonos)) return g - k; if (esTono(g + k, tonos)) return g + k; }
  return g;
}
int gradoDePc(int g, int pc) {                    // el grado más cercano a g que sea la clase de altura pc
  for (int k = 0; k < 7; k++) { if (pcGrado(g - k) == pc) return g - k; if (pcGrado(g + k) == pc) return g + k; }
  return g;
}
int tonosEnRango(int lo, int hi, uint16_t tonos, int *out) {
  int n = 0;
  for (int g = lo; g <= hi && n < 16; g++) if (esTono(g, tonos)) out[n++] = g;
  return n;
}

