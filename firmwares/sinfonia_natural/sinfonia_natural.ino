struct NotaVuela { bool viva; float x, y, vx, vy, t, vida, fase; uint8_t glifo; };
#define NUM_NOTAS_VUELAN 7
NotaVuela notasVuelan[NUM_NOTAS_VUELAN];
uint8_t  pantalla[1024];
uint32_t rngPant = 0x9E3779B9u;
float azarPant() { rngPant ^= rngPant << 13; rngPant ^= rngPant >> 17; rngPant ^= rngPant << 5; return (rngPant >> 8) * (1.0f / 16777216.0f); }

// glifos: filas de arriba a abajo, bit 7 = columna izquierda
struct Glifo { uint8_t w, h; uint8_t f[7]; };
const Glifo GLIFOS[4] = {
  { 5, 7, { 0x20, 0x30, 0x28, 0x20, 0x60, 0xE0, 0xC0 } },       // corchea
  { 8, 7, { 0x3F, 0x21, 0x21, 0x21, 0x63, 0xE7, 0xC6 } },       // dos corcheas unidas
  { 4, 4, { 0xF0, 0x20, 0x40, 0xF0, 0, 0, 0 } },                // z chica
  { 5, 5, { 0xF8, 0x10, 0x20, 0x40, 0xF8, 0, 0 } },             // z grande
};
enum { G_CORCHEA, G_DOBLE, G_ZCHICA, G_ZGRANDE };

void pixelPant(int x, int y) {
  if (x < 0 || x > 127 || y < 0 || y > 63) return;
  pantalla[(y >> 3) * 128 + x] |= (uint8_t)(1u << (y & 7));
}
void glifoPant(int g, int x, int yAbajo) {                  // (x, yAbajo) = esquina de abajo a la izquierda
  const Glifo &G = GLIFOS[g];
  for (int r = 0; r < G.h; r++)
    for (int c = 0; c < G.w; c++)
      if (G.f[r] & (0x80 >> c)) pixelPant(x + c, yAbajo - G.h + 1 + r);
}
void soltarNota(uint8_t glifo, float x, float y, float vx, float vy, float vida) {
  for (int i = 0; i < NUM_NOTAS_VUELAN; i++) {
    NotaVuela &n = notasVuelan[i];
    if (n.viva) continue;
    n = NotaVuela{ true, x, y, vx, vy, 0.0f, vida, azarPant() * 6.283f, glifo };
    return;
  }
}

bool oledComandos(const uint8_t *c, int n) {
  Wire.beginTransmission(OLED_DIR);
  Wire.write((uint8_t)0x00);                                   // Co = 0, D/C = 0: comandos
  Wire.write(c, n);
  return Wire.endTransmission() == 0;
}
