void setup() {
  Serial.begin(115200);
  Serial.setTxTimeoutMs(0);   // OBLIGATORIO con audio: un print por USB CDC bloquea hasta que el PC lea
#if ARDUINO_USB_CDC_ON_BOOT
  Serial0.begin(115200);      // el otro conector USB de la DevKitC-1
#endif
  LOG("\n=== PERCU-SYNTH · SINFONÍA NATURAL ===\n");
  LOG("Escala: E F# G# A B D# · %d sonidos naturales grabados\n", NUM_MUESTRAS);
  for (int b = 0; b < 5; b++) pinMode(BTN_PIN[b], INPUT_PULLUP);
  analogReadResolution(12);
  analogSetAttenuation(ADC_11db);
  for (int i = 0; i < 4; i++) { float v = leerPot(POT_PIN[i]); if (i == 0) potVol = v < 0.01f ? 0.0f : powf(v, CURVA_VOLUMEN); else if (i == 1) potBal = v; else if (i == 2) potDens = v; else potVert = v; }
  mezclarSemilla(micros() ^ ((uint32_t)analogRead(POT_PIN[0]) << 12));
  iniciarAudio();
  i2s_init();
  xTaskCreatePinnedToCore(audioTask,   "audio",   8192, NULL, 10, NULL, 1);
  xTaskCreatePinnedToCore(controlTask, "control", 6144, NULL,  3, NULL, 0);
  xTaskCreatePinnedToCore(pantallaTask, "pantalla", 4096, NULL, 1, NULL, 0);   // por debajo de los controles
  LOG("Listo: BTN1 play/stop · BTN2 escena (otros instrumentos) · BTN3 ave · BTN4 campanitas · BTN5 animal grabado\n");
  LOG("       POT1 volumen · POT2 música → naturaleza · POT3 densidad · POT4 vertiente\n");
}

