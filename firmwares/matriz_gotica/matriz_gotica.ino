const uint8_t FOCO[6][2] = { { 64, 17 }, { 64, 29 }, { 64, 15 }, { 102, 13 }, { 64, 34 }, { 64, 22 } };   // de dónde sale la luz en cada lugar (x, y)
// <<< FONDOS

uint8_t pantalla[1024];                             // el cuadro, en el orden de memoria del SSD1306
static inline void punto(int x, int y, bool on) {
  if (x < 0 || x > 127 || y < 0 || y > 63) return;
  if (on) pantalla[(y >> 3) * 128 + x] |= (uint8_t)(1 << (y & 7)); else pantalla[(y >> 3) * 128 + x] &= (uint8_t)~(1 << (y & 7));
}
void rectPant(int x0, int y0, int x1, int y1, bool on) { for (int y = y0; y <= y1; y++) for (int x = x0; x <= x1; x++) punto(x, y, on); }
void discoPant(int cx, int cy, int r, bool on) { for (int y = -r; y <= r; y++) for (int x = -r; x <= r; x++) if (x * x + y * y <= r * r + r / 2) punto(cx + x, cy + y, on); }
void lineaPant(int x0, int y0, int x1, int y1, bool on, int grosor) {
  int dx = abs(x1 - x0), dy = abs(y1 - y0), sx = x0 < x1 ? 1 : -1, sy = y0 < y1 ? 1 : -1, e = dx - dy;
  for (;;) {
    if (grosor <= 1) punto(x0, y0, on); else rectPant(x0 - 1, y0 - 1, x0 + 1, y0 + 1, on);
    if (x0 == x1 && y0 == y1) break;
    int e2 = 2 * e; if (e2 > -dy) { e -= dy; x0 += sx; } if (e2 < dx) { e += dx; y0 += sy; }
  }
}

// Una persona: cabeza, tronco, dos brazos y su peinado (0 liso · 1 cresta · 2 pelo largo · 3 sombrero de copa).
// Primero se pinta en negro un poco más grande (el contorno que la separa del fondo) y después en blanco.
void personaPant(int x, int pies, int alto, int peinado, bool arriba, int ladeo) {
  const int cab = pies - alto + 2, hombro = cab + 4;
  for (int pasada = 0; pasada < 2; pasada++) {
    const bool on = pasada == 1; const int g = on ? 0 : 1;
    rectPant(x - 2 - g, hombro - g, x + 2 + g, 63, on);                        // tronco (hasta el borde: el piso es la gente)
    discoPant(x + ladeo, cab, 2 + g, on);                                      // cabeza
    for (int s = -1; s <= 1; s += 2) {                                         // brazos
      const int hx = x + s * 3, mx = arriba ? x + s * 6 + ladeo : x + s * 5, my = arriba ? cab - 4 : hombro + 6;
      lineaPant(hx, hombro + 1, mx, my, on, on ? 1 : 3);
      if (on) punto(mx, my - (arriba ? 1 : 0), true);
    }
    if (peinado == 1) { for (int k = -2; k <= 2; k += 2) lineaPant(x + ladeo + k, cab - 2, x + ladeo + k, cab - 5 + abs(k) / 2, on, on ? 1 : 3); }
    else if (peinado == 2) { rectPant(x + ladeo - 3 - g, cab - 1, x + ladeo - 3, hombro + 3, on); rectPant(x + ladeo + 3, cab - 1, x + ladeo + 3 + g, hombro + 3, on); }
    else if (peinado == 3) { rectPant(x + ladeo - 2 - g, cab - 6 - g, x + ladeo + 2 + g, cab - 3, on); rectPant(x + ladeo - 3 - g, cab - 3, x + ladeo + 3 + g, cab - 3 + g, on); }
  }
}
void murcielagoPant(int x, int y, bool alasArriba) {
  const int a = alasArriba ? -1 : 1;
  punto(x, y, true); punto(x - 1, y, true); punto(x + 1, y, true); punto(x, y + 1, true);
  punto(x - 1, y - 1, true); punto(x + 1, y - 1, true);                         // orejas
  for (int s = -1; s <= 1; s += 2) { punto(x + s * 2, y + a, true); punto(x + s * 3, y + a, true); punto(x + s * 4, y + 2 * a, true); punto(x + s * 5, y + a, true); }
}

// Estado de la fiesta (lo toca sólo la tarea de la pantalla)
uint32_t oVisto[NUM_EV]; bool oPrimera = true;
float oBombo = 0, oCaja = 0, oRayos = 0, oT = 0; bool oAlas = false; int oDestello = 0;
float murX[NUM_MURCIELAGOS] = { 10, 60, 105 };

// Arma un cuadro. Devuelve en `contraste` e `invertida` cómo debe quedar el panel.
void armarCuadro(float dt, uint8_t &contraste, bool &invertida) {
  const int esc = reqC.escenario; const bool corre = tocandoPub;
  bool nuevo[NUM_EV];
  for (int ev = 0; ev < NUM_EV; ev++) { const uint32_t g = golpes[ev]; nuevo[ev] = !oPrimera && g != oVisto[ev]; oVisto[ev] = g; }
  oPrimera = false;
  if (nuevo[EV_BOMBO]) { oBombo = velGolpe[EV_BOMBO]; oRayos = 1.0f; }
  if (nuevo[I_CAJA] || nuevo[I_CLAP]) { oCaja = 1.0f; if (OLED_DESTELLO && velGolpe[nuevo[I_CAJA] ? I_CAJA : I_CLAP] > 0.9f) oDestello = 2; }
  if (nuevo[I_HAT] || nuevo[I_ABIERTO]) oAlas = !oAlas;
  oBombo *= expf(-dt / 0.13f); oCaja *= expf(-dt / 0.16f); oRayos *= expf(-dt / 0.10f);
  oT += dt;
  const float fase = fasePub - floorf(fasePub);            // 0 … 1 dentro de la negra
  const uint32_t negra = pasoTotalPub >> 2;

  memcpy_P(pantalla, FONDO[esc], 1024);

  // la luz del lugar: crece con el bajo y tira rayos con el bombo
  const int fx = FOCO[esc][0], fy = FOCO[esc][1];
  if (corre) {
    const int rb = (int)(1.5f + 3.0f * envBajoPub);
    discoPant(fx, fy, rb, true);
    if (oRayos > 0.06f) {
      const float r0 = rb + 3.0f, r1 = r0 + 4.0f + 20.0f * oRayos;
      for (int k = 0; k < 12; k++) {
        const float a = (k + ((negra & 1) ? 0.5f : 0.0f)) * 0.5235988f, c = cosf(a), s = sinf(a);
        lineaPant(fx + (int)(r0 * c), fy + (int)(r0 * s), fx + (int)(r1 * c), fy + (int)(r1 * s * 0.8f), true, 1);
      }
    }
  }

  // murciélagos: cruzan arriba con el tempo y aletean con los hats
  if (corre) for (int m = 0; m < NUM_MURCIELAGOS; m++) {
    murX[m] += dt * (bpmPub / 60.0f) * (7.0f + 3.0f * m) * ((m & 1) ? -1.0f : 1.0f);
    if (murX[m] > 134.0f) murX[m] -= 140.0f; if (murX[m] < -6.0f) murX[m] += 140.0f;
    murcielagoPant((int)murX[m], 5 + 3 * m + (int)(2.0f * sinf(oT * 3.0f + 2.1f * m)), oAlas ^ (m == 1));
  }

  // la gente: los pares saltan con el bombo, los impares en el contratiempo; brazos arriba con la caja
  const float contra = corre ? fmaxf(0.0f, sinf(6.2831853f * (fase - 0.25f))) : 0.0f;
  for (int i = 0; i < NUM_GENTE; i++) {
    uint32_t h = (uint32_t)(i + 1) * 2654435761u; h ^= h >> 15;
    const int alto = 15 + (int)(h % 5), peinado = (int)((h >> 5) & 3);
    const int salto = corre ? (int)lroundf((i & 1) ? 2.5f * contra : 4.0f * oBombo) : 0;
    const bool arriba = corre && (((h >> 9) & 1) ? oCaja > 0.25f : (oBombo > 0.45f && ((negra + i) & 3) == 0));
    const int ladeo = corre ? ((((negra + i) & 1) ? 1 : -1) * (((h >> 11) & 1) ? 1 : 0)) : 0;
    personaPant(7 + i * 14 + (int)((h >> 13) % 3), 63 - salto, alto, peinado, arriba, ladeo);
  }

  contraste = corre ? (uint8_t)(OLED_CONTRASTE_BASE + (OLED_CONTRASTE_BOMBO - OLED_CONTRASTE_BASE) * fminf(1.0f, oBombo)) : OLED_CONTRASTE_QUIETA;
  invertida = corre && oDestello > 0; if (oDestello > 0) oDestello--;
}

#ifndef SIN_PANTALLA
bool oledComandos(const uint8_t *c, int n) {
  Wire.beginTransmission(OLED_DIR);
  Wire.write((uint8_t)0x00);                                   // Co = 0, D/C = 0: comandos
  Wire.write(c, n);
  return Wire.endTransmission() == 0;
}
bool oledIniciar() {
  const uint8_t init[] = {
    0xAE, 0xD5, 0x80, 0xA8, 0x3F, 0xD3, 0x00, 0x40, 0x8D, 0x14, 0x20, 0x00,
    (uint8_t)(OLED_GIRO_180 ? 0xA0 : 0xA1), (uint8_t)(OLED_GIRO_180 ? 0xC0 : 0xC8),
    0xDA, 0x12, 0x81, OLED_CONTRASTE_QUIETA, 0xD9, 0xF1, 0xDB, 0x40, 0xA4, 0xA6, 0x2E, 0xAF
  };
  return oledComandos(init, sizeof(init));
}
bool oledCuadro() {
  const uint8_t ventana[] = { 0x21, 0, 127, 0x22, 0, 7 };
  if (!oledComandos(ventana, sizeof(ventana))) return false;
  for (int i = 0; i < 1024; i += 64) {                         // el buffer de Wire es de 128: trozos de 64
    Wire.beginTransmission(OLED_DIR);
    Wire.write((uint8_t)0x40);                                 // D/C = 1: datos
    Wire.write(pantalla + i, 64);
    if (Wire.endTransmission() != 0) return false;
  }
  return true;
}
bool oledPresente() { Wire.beginTransmission(OLED_DIR); return Wire.endTransmission() == 0; }

void pantallaTask(void *) {
  Wire.begin(OLED_SDA, OLED_SCL, OLED_I2C_HZ);                 // en el core 0: sus interrupciones quedan lejos del audio
  Wire.setTimeOut(20);
  bool lista = false, invAhora = false; uint8_t conAhora = OLED_CONTRASTE_QUIETA;
  unsigned long tAnt = millis();
  for (;;) {
    if (!lista) {
      if (oledPresente() && oledIniciar()) { lista = true; invAhora = false; conAhora = OLED_CONTRASTE_QUIETA; oPrimera = true; tAnt = millis(); }
      else { vTaskDelay(3000 / portTICK_PERIOD_MS); continue; }
    }
    const unsigned long t = millis();
    float dt = (t - tAnt) * 0.001f; tAnt = t; if (dt > 0.1f) dt = 0.1f;
    uint8_t con; bool inv;
    armarCuadro(dt, con, inv);
    bool ok = true;
    if (inv != invAhora) { const uint8_t cmd[1] = { (uint8_t)(inv ? 0xA7 : 0xA6) }; ok = oledComandos(cmd, 1); if (ok) invAhora = inv; }
    if (ok && abs((int)con - (int)conAhora) > 6) { const uint8_t cmd[2] = { 0x81, con }; ok = oledComandos(cmd, 2); if (ok) conAhora = con; }
    if (ok) ok = oledCuadro();
    if (!ok) { lista = false; continue; }                      // se desconectó: vuelve a buscarla
    vTaskDelay(6 / portTICK_PERIOD_MS);                        // con lo que tarda el I2C, ~25 cuadros por segundo
  }
}
#endif

// ==============================================================================================================================================
// CONTROLES (tarea de control, core 0, 1 kHz)
// ==============================================================================================================================================
bool bNivel[5] = { HIGH, HIGH, HIGH, HIGH, HIGH };
unsigned long bTiempo[5];
Ctl  ctl;                           // lo que mandan los botones
int  panel = P_GENERAL;
// BTN5: un toque entra o sale del break. Mantenido BREAK_LARGO_MS arranca la SUBIDA del v1 (16
// compases que terminan en un golpe y esperan en silencio); el próximo toque es el DROP.
const unsigned long BREAK_LARGO_MS = 2000;
unsigned long t5 = 0;
bool sosteniendo5 = false, enSubida = false;

float readPot(uint8_t pin) {
  uint32_t s = 0;
  for (int i = 0; i < 4; i++) s += analogRead(pin);   // 4 y no 8: cada analogRead del S3 cuesta decenas de µs
  return (float)(s >> 2) / 4095.0f;
}
// Pick-up: al cambiar de panel cada pot queda "suelto" hasta que lo muevas un 4 %; desde ahí su
// posición es el valor. Así cambiar de panel nunca hace saltar nada.
float potEntrada[4];
bool  potTomado[4] = { true, true, true, true };
const float UMBRAL_TOMA = 0.04f;
void soltarPots() { for (int i = 0; i < 4; i++) { potEntrada[i] = readPot(POT_PIN[i]); potTomado[i] = false; } }

void publicarCtl() { memcpy((void *)&reqC, &ctl, sizeof(ctl)); }

void aplicarEscenario(int e) {                        // el escenario trae sus patrones y sus timbres; después se cambian en cada panel
  const Escenario &E = ESCENARIOS[e];
  ctl.escenario = e;
  ctl.patDrum = 0; ctl.patBajo = 0; ctl.patMel = 0;
  ctl.kit = E.kit; ctl.tBajo = E.tBajo; ctl.tMel = E.tMel; ctl.tOsc = E.tOsc;
  ctl.glide = E.tBajo == TB_808;                  // el 808 se desliza entre notas
  ctl.octBajo = E.octBajo;                        // el bajo gótico va una octava arriba
}

void cambiarPanel(int p) {
  panel = p; panelPub = p; panelCambioMs = millis();
  soltarPots();
}

// Un botón = una función, en el flanco de presión. En TODOS los paneles BTN4 pasa al siguiente
// panel y BTN5 entra o sale del break; BTN1–BTN3 son del panel.
void accionBoton(int b) {
  if (b == 3) {
    cambiarPanel((panel + 1) % NUM_PANELES);
  } else if (b == 4) {
    if (enSubida) { enSubida = false; ctl.brk = false; reqDrop = reqDrop + 1; }   // el DROP: todo desde el "1"
    else { ctl.brk = !ctl.brk; t5 = millis(); sosteniendo5 = true; }
  } else switch (panel) {
    case P_GENERAL:
      if (b == 0)      { ctl.tocar = !ctl.tocar; ctl.brk = false; enSubida = false; }
      else if (b == 1) aplicarEscenario((ctl.escenario + 1) % NUM_ESCENARIOS);
      else             reqFill = reqFill + 1;
      break;
    case P_BAJO:
      if (b == 0)      ctl.distBajo = !ctl.distBajo;            // distorsión sí / no
      else if (b == 1) ctl.patBajo = (ctl.patBajo + 1) % NUM_PAT;
      else             { ctl.tBajo = (ctl.tBajo + 1) % NUM_TBAJO; ctl.glide = ctl.tBajo == TB_808; }
      break;
    case P_DRUM:
      if (b == 0)      ctl.extra = (ctl.extra + 1) % (NUM_EXTRA + 1);   // percusión extra: 1 → 2 → 3 pistas → nada
      else if (b == 1) ctl.patDrum = (ctl.patDrum + 1) % NUM_PAT;
      else             ctl.kit = (ctl.kit + 1) % NUM_KITS;
      break;
    case P_MEL:
      if (b == 0)      ctl.octMel = (ctl.octMel + 1) % 3;       // octava: normal → +1 → −1
      else if (b == 1) ctl.patMel = (ctl.patMel + 1) % NUM_PAT;
      else             ctl.tMel = (ctl.tMel + 1) % NUM_TMEL;
      break;
    case P_OSC:
      if (b == 0)      ctl.oscOn = !ctl.oscOn;
      else if (b == 1) ctl.tOsc = (ctl.tOsc + 1) % NUM_TOSC;
      else             ctl.octOsc = (ctl.octOsc + 1) % 3;   // normal → +1 → −1
      break;
    case P_SAMPLES:
      reqBanco[b] = reqBanco[b] + 1;              // BTN1 golpes · BTN2 voces · BTN3 fx
      break;
  }
  publicarCtl();
}

void pasoControl() {
  unsigned long ahora = millis();
  for (int b = 0; b < 5; b++) {
    bool nivel = digitalRead(BTN_PIN[b]);
    if (nivel == LOW && bNivel[b] == HIGH && (ahora - bTiempo[b]) > DEBOUNCE_MS) {
      bTiempo[b] = ahora;
      accionBoton(b);
    }
    bNivel[b] = nivel;
  }
  if (sosteniendo5 && bNivel[4] == HIGH) sosteniendo5 = false;
  if (sosteniendo5 && ahora - t5 > BREAK_LARGO_MS) {   // mantenido: empieza la SUBIDA
    sosteniendo5 = false;
    if (ctl.tocar) { enSubida = true; ctl.brk = true; reqSubida = reqSubida + 1; publicarCtl(); }
  }

  static uint8_t scan = 0;
  int i = scan; scan = (scan + 1) & 3;
  float v = readPot(POT_PIN[i]);
  if (!potTomado[i] && fabsf(v - potEntrada[i]) > UMBRAL_TOMA) potTomado[i] = true;
  if (potTomado[i]) pPot[panel][i] += (v - pPot[panel][i]) * 0.3f;
}

