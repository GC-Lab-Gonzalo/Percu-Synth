    mute, breakPub ? (estadoSubPub == E_SUBIDA ? 2 : (estadoSubPub == E_ESPERA ? 3 : 1)) : 0, repeatPub ? 1 : 0, fillPub ? 1 : 0,
    (int)(pPot[P_GENERAL][2] * 1000), (int)(pPot[P_GENERAL][3] * 1000), (int)(pPot[P_DRUM][3] * 1000),
